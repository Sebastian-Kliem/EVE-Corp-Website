<div class="brand-title-container">
    <span class="brand-title">
        Keepers of Duat
    </span>
</div>

<nav class="navbar" role="navigation" aria-label="main navigation" data-controller="navbar">

    <div class="container">

        <div class="navbar-brand">
            <a class="navbar-item brand-mobile-title" href="{{ path('home') }}">
                Keepers of Duat
            </a>
            <button class="navbar-burger" aria-label="menu" aria-expanded="false" data-navbar-target="burger" data-action="click->navbar#toggle">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </button>
        </div>

        <div class="navbar-menu" data-navbar-target="menu">
            <div class="navbar-start">
                <a class="navbar-item" href="{{ path('home') }}">Home</a>
                {% if is_granted('ROLE_MEMBER') %}
                    <!-- Allgemein -->
                    <div class="navbar-item has-dropdown" data-controller="dropdown">
                        <a class="navbar-link is-arrowless" data-action="click->dropdown#toggle">
                            Allgemein <span class="dropdown-caret">▼</span>
                        </a>
                        <div class="navbar-dropdown">
                            <a class="navbar-item" href="{{ path('link_collection') }}">Linksammlung</a>
                            <a class="navbar-item" href="{{ path('app_suggestions') }}">Vorschläge</a>
                        </div>
                    </div>

                    <!-- Corp -->
                    <div class="navbar-item has-dropdown" data-controller="dropdown">
                        <a class="navbar-link is-arrowless" data-action="click->dropdown#toggle">
                            Corp <span class="dropdown-caret">▼</span>
                        </a>
                        <div class="navbar-dropdown">
                            <a class="navbar-item" href="{{ path('app_order_list') }}">Orders</a>
                            <a class="navbar-item" href="{{ path('app_corp_assets_overview') }}" data-turbo="false">Corp-Inventar</a>
                        </div>
                    </div>

                    <!-- Persönlich -->
                    <div class="navbar-item has-dropdown" data-controller="dropdown">
                        <a class="navbar-link is-arrowless" data-action="click->dropdown#toggle">
                            Persönlich <span class="dropdown-caret">▼</span>
                        </a>
                        <div class="navbar-dropdown">
                            <a class="navbar-item" href="{{ path('app_profile') }}" data-turbo="false">
                                Mein Profil
                            </a>
                            <a class="navbar-item is-disabled" href="#" onclick="return false;">Charakterübersicht (in Kürze)</a>
                            <a class="navbar-item" href="{{ path('app_profile_pi_overview') }}" data-turbo="false">PI-Planung</a>
                            <a class="navbar-item" href="{{ path('app_profile_mining_ledger') }}" data-turbo="false">Bergbautagebuch</a>
                            <a class="navbar-item is-disabled" href="#" onclick="return false;">Produktionsplanung (in Kürze)</a>
                            <a class="navbar-item" href="{{ path('app_profile_assets_overview') }}" data-turbo="false">Inventar</a>
                        </div>
                    </div>

                    {% if is_granted('ROLE_CEO') %}
                    <!-- Admin Panel -->
                    <div class="navbar-item has-dropdown" data-controller="dropdown">
                        <a class="navbar-link is-arrowless" data-action="click->dropdown#toggle">
                            ⚙️ Admin-Panel <span class="dropdown-caret">▼</span>
                        </a>
                        <div class="navbar-dropdown">
                            <a class="navbar-item" href="{{ path('app_admin_users') }}" data-turbo="false">
                                Benutzerverwaltung
                            </a>
                            <a class="navbar-item" href="{{ path('app_admin_corp_assets_visibility') }}" data-turbo="false">
                                Hangar-Sichtbarkeit
                            </a>
                            <a class="navbar-item" href="{{ path('app_admin_cron_index') }}" data-turbo="false">
                                Cron-Jobs
                            </a>
                        </div>
                    </div>
                    {% endif %}

                {% endif %}
            </div>

            <div class="navbar-end">
                {% if app.user %}
                    <a class="navbar-item" href="{{ path('app_logout') }}">
                        🚪 Logout
                    </a>
                {% else %}
                    <div class="navbar-item">
                        <a class="button is-small is-primary" href="{{ path('app_login') }}" data-turbo="false">
                            Login
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

