<!-- Top Brand Title (Desktop only) -->
<div class="hidden lg:block text-center pt-6 pb-3">
    <a class="tracking-wider uppercase text-transparent bg-clip-text bg-gradient-to-r from-eve-primary to-purple-400 text-3xl font-bold no-underline inline-block transition-all hover:scale-102 hover:opacity-95" href="{{ path('home') }}">
        Keepers of Duat
    </a>
</div>

<nav class="relative z-30 bg-[#0d121fe6] border-b border-eve-border backdrop-blur-md mb-8" role="navigation" aria-label="main navigation" data-controller="navbar">
    <div class="w-full max-w-[1200px] mx-auto px-6">

        <!-- Brand & Burger (Mobile only) -->
        <div class="flex items-center justify-between lg:hidden w-full h-13">
            <a class="uppercase tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-eve-primary to-purple-400 text-lg font-bold no-underline" href="{{ path('home') }}">
                Keepers of Duat
            </a>
            <button class="flex flex-col justify-center items-center gap-1 w-13 h-13 bg-transparent border-none cursor-pointer z-40 group" aria-label="menu" aria-expanded="false" data-navbar-target="burger" data-action="click->navbar#toggle">
                <span class="block w-5 h-[2px] bg-eve-primary rounded-[2px] transition-transform duration-300 [.is-active_&]:translate-y-[6px] [.is-active_&]:rotate-45"></span>
                <span class="block w-5 h-[2px] bg-eve-primary rounded-[2px] transition-opacity duration-300 [.is-active_&]:opacity-0"></span>
                <span class="block w-5 h-[2px] bg-eve-primary rounded-[2px] transition-transform duration-300 [.is-active_&]:-translate-y-[6px] [.is-active_&]:-rotate-45"></span>
            </button>
        </div>

        <!-- Menu -->
        {% set current_route = app.request.attributes.get('_route') %}
        {% set is_allgemein_active = current_route in ['link_collection', 'app_suggestions', 'app_general_reactions'] %}
        {% set is_corp_active = current_route in ['app_order_list', 'app_dashboard_corp_assets_overview', 'app_corp_blueprints', 'app_corp_structures', 'app_tracking_index', 'app_corp_defense_doctrine'] %}
        {% set is_personlich_active = current_route in ['app_profile', 'app_profile_characters', 'app_profile_skill_farm', 'app_dashboard_pi_overview', 'app_dashboard_mining_ledger', 'app_dashboard_industry_overview', 'app_dashboard_assets_overview', 'app_dashboard_eve_character_assets', 'app_dashboard_eve_character_details', 'app_dashboard_market_overview'] %}
        {% set is_admin_active = current_route in ['app_admin_users', 'app_admin_corp_assets_visibility', 'app_admin_cron_index', 'app_admin_discord_index'] %}

        {% set nav_trigger_base = "cursor-pointer flex items-center gap-2 py-2 font-semibold select-none no-underline transition-all duration-200 " %}
        {% set nav_item_base = "block w-full text-left py-2 px-5 no-underline transition-all duration-200 text-sm " %}
        {% set nav_item_normal = nav_item_base ~ "text-eve-muted hover:text-eve-primary hover:bg-white/5" %}
        {% set nav_item_active = nav_item_base ~ "text-eve-primary bg-eve-primary/5 border-l-2 border-eve-primary pl-[18px] font-semibold" %}

        <div class="hidden lg:flex lg:items-center lg:justify-between w-full bg-[#0d121ffa] lg:bg-transparent border border-eve-border lg:border-none shadow-eve lg:shadow-none rounded-lg lg:rounded-none p-4 lg:p-0 absolute lg:static left-6 right-6 top-full [&.is-active]:block" data-navbar-target="menu">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center gap-4 lg:gap-6 w-full lg:w-auto">
                {% if is_granted('ROLE_MEMBER') %}

                    <!-- Allgemein Dropdown -->
                    <div class="relative group" data-controller="dropdown">
                        <a class="{{ nav_trigger_base }} {{ is_allgemein_active ? 'text-eve-primary [text-shadow:0_0_8px_rgba(0,240,255,0.4)]' : 'text-white/70 hover:text-eve-primary hover:[text-shadow:0_0_8px_rgba(0,240,255,0.4)]' }}" data-action="click->dropdown#toggle">
                            Allgemein <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute lg:absolute top-full right-0 lg:left-0 lg:right-auto bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[180px] py-2 z-20">
                            <a class="{{ current_route == 'link_collection' ? nav_item_active : nav_item_normal }}" href="{{ path('link_collection') }}">Linksammlung</a>
                            <a class="{{ current_route == 'app_suggestions' ? nav_item_active : nav_item_normal }}" href="{{ path('app_suggestions') }}">Vorschläge</a>
                            <a class="{{ current_route == 'app_general_reactions' ? nav_item_active : nav_item_normal }}" href="{{ path('app_general_reactions') }}">Wurmloch-Reaktionen</a>
                        </div>
                    </div>

                    <!-- Corp Dropdown -->
                    <div class="relative group" data-controller="dropdown">
                        <a class="{{ nav_trigger_base }} {{ is_corp_active ? 'text-eve-primary [text-shadow:0_0_8px_rgba(0,240,255,0.4)]' : 'text-white/70 hover:text-eve-primary hover:[text-shadow:0_0_8px_rgba(0,240,255,0.4)]' }}" data-action="click->dropdown#toggle">
                            Corp <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute lg:absolute top-full right-0 lg:left-0 lg:right-auto bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[180px] py-2 z-20">
                            <a class="{{ current_route == 'app_corp_defense_doctrine' ? nav_item_active : nav_item_normal }}" href="{{ path('app_corp_defense_doctrine') }}" data-turbo="false">Verteidigungsdoktrin</a>
                            <a class="{{ current_route == 'app_order_list' ? nav_item_active : nav_item_normal }}" href="{{ path('app_order_list') }}">Orders</a>
                            <a class="{{ current_route == 'app_dashboard_corp_assets_overview' ? nav_item_active : nav_item_normal }}" href="{{ path('app_dashboard_corp_assets_overview') }}" data-turbo="false">Corp-Inventar</a>
                            <a class="{{ current_route == 'app_corp_blueprints' ? nav_item_active : nav_item_normal }}" href="{{ path('app_corp_blueprints') }}" data-turbo="false">Blueprint-Tresor</a>
                            <a class="{{ current_route == 'app_corp_structures' ? nav_item_active : nav_item_normal }}" href="{{ path('app_corp_structures') }}" data-turbo="false">Stationen</a>
                        </div>
                    </div>

                    <!-- Persönlich Dropdown -->
                    <div class="relative group" data-controller="dropdown">
                        <a class="{{ nav_trigger_base }} {{ is_personlich_active ? 'text-eve-primary [text-shadow:0_0_8px_rgba(0,240,255,0.4)]' : 'text-white/70 hover:text-eve-primary hover:[text-shadow:0_0_8px_rgba(0,240,255,0.4)]' }}" data-action="click->dropdown#toggle">
                            Persönlich <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute lg:absolute top-full right-0 lg:left-0 lg:right-auto bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[180px] py-2 z-20">
                            <a class="{{ current_route == 'app_profile' ? nav_item_active : nav_item_normal }}" href="{{ path('app_profile') }}" data-turbo="false">Mein Profil</a>
                            <a class="{{ current_route in ['app_profile_characters', 'app_dashboard_eve_character_assets', 'app_dashboard_eve_character_details'] ? nav_item_active : nav_item_normal }}" href="{{ path('app_profile_characters') }}" data-turbo="false">Charakterübersicht</a>
                            <a class="{{ current_route == 'app_profile_skill_farm' ? nav_item_active : nav_item_normal }}" href="{{ path('app_profile_skill_farm') }}" data-turbo="false">Skill-Farmen</a>
                            <a class="{{ current_route == 'app_dashboard_pi_overview' ? nav_item_active : nav_item_normal }}" href="{{ path('app_dashboard_pi_overview') }}" data-turbo="false">PI-Planung</a>
                            <a class="{{ current_route == 'app_dashboard_mining_ledger' ? nav_item_active : nav_item_normal }}" href="{{ path('app_dashboard_mining_ledger') }}" data-turbo="false">Bergbautagebuch</a>
                            <a class="{{ current_route == 'app_dashboard_industry_overview' ? nav_item_active : nav_item_normal }}" href="{{ path('app_dashboard_industry_overview') }}" data-turbo="false">Industrie-Aufträge</a>
                            <a class="{{ current_route == 'app_dashboard_assets_overview' ? nav_item_active : nav_item_normal }}" href="{{ path('app_dashboard_assets_overview') }}" data-turbo="false">Inventar & Wallet</a>
                            <a class="{{ current_route == 'app_dashboard_market_overview' ? nav_item_active : nav_item_normal }}" href="{{ path('app_dashboard_market_overview') }}" data-turbo="false">Marktaufträge</a>
                        </div>
                    </div>

                    {% if is_granted('ROLE_OFFICER') %}
                    <!-- Admin Panel Dropdown -->
                    <div class="relative group" data-controller="dropdown">
                        <a class="{{ nav_trigger_base }} {{ is_admin_active ? 'text-eve-primary [text-shadow:0_0_8px_rgba(0,240,255,0.4)]' : 'text-white/70 hover:text-eve-primary hover:[text-shadow:0_0_8px_rgba(0,240,255,0.4)]' }}" data-action="click->dropdown#toggle">
                            ⚙️ Admin-Panel <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute lg:absolute top-full right-0 lg:left-0 lg:right-auto bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[180px] py-2 z-20">
                            <a class="{{ current_route == 'app_admin_users' ? nav_item_active : nav_item_normal }}" href="{{ path('app_admin_users') }}" data-turbo="false">Benutzerverwaltung</a>
                            {% if is_granted('ROLE_CEO') %}
                                <a class="{{ current_route == 'app_admin_corp_assets_visibility' ? nav_item_active : nav_item_normal }}" href="{{ path('app_admin_corp_assets_visibility') }}" data-turbo="false">Hangar-Sichtbarkeit</a>
                                <a class="{{ current_route == 'app_admin_cron_index' ? nav_item_active : nav_item_normal }}" href="{{ path('app_admin_cron_index') }}" data-turbo="false">Cron-Jobs</a>
                                <a class="{{ current_route == 'app_admin_discord_index' ? nav_item_active : nav_item_normal }}" href="{{ path('app_admin_discord_index') }}" data-turbo="false">Discord-Webhooks</a>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                {% endif %}
            </div>


            <div class="flex items-center gap-4 mt-4 lg:mt-0">
                {% if app.user %}
                    <!-- Online Users Indicator (links neben Logout) -->
                    {% set online_status = get_online_status() %}
                    <div class="relative group" data-controller="dropdown online-status" data-online-status-url-value="{{ path('app_online_status') }}">
                        <a class="nav-trigger cursor-pointer no-underline py-2 lg:py-0" 
                           data-action="click->dropdown#toggle" 
                           title="Eingeloggte Spieler in EVE Online">
                            <span class="relative flex h-2 w-2 mr-0.5">
                                <span data-online-status-target="ping" class="{{ online_status.userCount > 0 ? 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75' : 'hidden' }}"></span>
                                <span data-online-status-target="dot" class="relative inline-flex rounded-full h-2 w-2 {{ online_status.userCount > 0 ? 'bg-emerald-400' : 'bg-slate-500' }}"></span>
                            </span>
                            <span class="whitespace-nowrap flex items-center gap-1 text-sm font-semibold">
                                <span data-online-status-target="count" class="font-bold">{{ online_status.userCount }}</span>
                                <span data-online-status-target="label">{{ online_status.userCount == 1 ? 'User' : 'User' }} online</span>
                            </span>
                            <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        
                        <!-- Dropdown showing online pilots / users -->
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute top-full right-0 mt-2 bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[260px] max-w-[340px] p-3 z-30 text-xs">
                            <div class="flex items-center justify-between pb-2 mb-2 border-b border-eve-border/40 font-semibold text-eve-text">
                                <span class="flex items-center gap-1.5">
                                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <span>EVE Online Status</span>
                                </span>
                                <span data-online-status-target="charCount" class="text-[0.7rem] px-1.5 py-0.5 rounded bg-white/5 text-eve-text font-semibold">
                                    {{ online_status.characterCount }} {{ online_status.characterCount == 1 ? 'Charakter' : 'Charaktere' }}
                                </span>
                            </div>
                            
                            <div data-online-status-target="list" class="space-y-2 max-h-[260px] overflow-y-auto pr-1">
                                {% if online_status.users is empty %}
                                    <div class="text-eve-muted py-2 text-center italic">
                                        Keine verknüpften Spieler online
                                    </div>
                                {% else %}
                                    {% for u in online_status.users %}
                                        <div class="p-2 rounded bg-white/[0.03] border border-eve-border/30">
                                            <div class="font-bold text-eve-text flex items-center justify-between">
                                                <span>{{ u.username }}</span>
                                                <span class="text-[0.7rem] text-emerald-400 font-medium">online</span>
                                            </div>
                                            <div class="mt-1.5 pl-2 border-l border-eve-primary/40 space-y-0.5 text-[0.8rem]">
                                                {% for c in u.characters %}
                                                    <div class="py-0.5 text-slate-300 font-medium truncate">
                                                        {{ c.name }}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            
                            <div class="mt-2 pt-2 border-t border-eve-border/30 text-[0.7rem] text-eve-muted text-center flex items-center justify-center gap-1">
                                <span>⏱ Aktualisierung: alle 5 Min.</span>
                            </div>
                        </div>
                    </div>

                    <a class="cursor-pointer py-2 lg:py-0 font-medium text-eve-muted hover:text-eve-primary no-underline transition-colors duration-200" href="{{ path('app_logout') }}">
                        🚪 Logout
                    </a>
                {% else %}
                    <div class="py-2 lg:py-0">
                        <a class="inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm px-4 py-2 shadow-eve transition-all duration-300 hover:-translate-y-0.5" href="{{ path('app_login') }}" data-turbo="false">
                            Login
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

