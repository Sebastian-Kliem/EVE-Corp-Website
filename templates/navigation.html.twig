<!-- Top Brand Title (Desktop only) -->
<div class="hidden lg:block text-center pt-6 pb-3">
    <a class="tracking-wider uppercase text-transparent bg-clip-text bg-gradient-to-r from-eve-primary to-purple-400 text-3xl font-bold no-underline inline-block transition-all hover:scale-102 hover:opacity-95" href="{{ path('home') }}">
        Keepers of Duat
    </a>
</div>

<nav class="relative z-30 bg-[#0d121fe6] border-b border-eve-border backdrop-blur-md mb-8" role="navigation" aria-label="main navigation" data-controller="navbar">
    <div class="app-container px-6">

        <!-- Brand & Burger (Mobile only) -->
        <div class="flex items-center justify-between lg:hidden w-full h-13">
            <a class="uppercase tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-eve-primary to-purple-400 text-lg font-bold no-underline" href="{{ path('home') }}">
                Keepers of Duat
            </a>
            <button class="flex flex-col justify-center items-center gap-1 w-13 h-13 bg-transparent border-none cursor-pointer z-40 group" aria-label="menu" aria-expanded="false" data-navbar-target="burger" data-action="click->navbar#toggle">
                <span class="block w-5 h-[2px] bg-eve-primary rounded-[2px] transition-transform duration-300 [.is-active_&]:translate-y-[6px] [.is-active_&]:rotate-45"></span>
                <span class="block w-5 h-[2px] bg-eve-primary rounded-[2px] transition-opacity duration-300 [.is-active_&]:opacity-0"></span>
                <span class="block w-5 h-[2px] bg-eve-primary rounded-[2px] transition-transform duration-300 [.is-active_&]:-translate-y-[6px] [.is-active_&]:-rotate-45"></span>
            </button>
        </div>

        <!-- Menu -->
        {% set nav_trigger_base = "cursor-pointer flex items-center gap-2 py-2 font-semibold select-none no-underline transition-all duration-200 " %}
        {% set nav_trigger_active = nav_trigger_base ~ "text-eve-primary [text-shadow:0_0_8px_rgba(0,240,255,0.4)]" %}
        {% set nav_trigger_normal = nav_trigger_base ~ "text-white/70 hover:text-eve-primary hover:[text-shadow:0_0_8px_rgba(0,240,255,0.4)]" %}
        {% set nav_item_base = "block w-full text-left py-2 px-5 no-underline transition-all duration-200 text-sm " %}
        {% set nav_item_normal = nav_item_base ~ "text-eve-muted hover:text-eve-primary hover:bg-white/5" %}
        {% set nav_item_active = nav_item_base ~ "text-eve-primary bg-eve-primary/5 border-l-2 border-eve-primary pl-[18px] font-semibold" %}

        <div class="hidden lg:flex lg:items-center lg:justify-between w-full bg-[#0d121ffa] lg:bg-transparent border border-eve-border lg:border-none shadow-eve lg:shadow-none rounded-lg lg:rounded-none p-4 lg:p-0 absolute lg:static left-6 right-6 top-full [&.is-active]:block" data-navbar-target="menu">
            <div class="flex flex-col lg:flex-row items-stretch lg:items-center gap-4 lg:gap-6 w-full lg:w-auto">
                {# Categories and items are defined in App\Service\Navigation\NavigationMenu #}
                {% for category in get_navigation('main') %}
                    <div class="relative group" data-controller="dropdown">
                        <a class="{{ category.active ? nav_trigger_active : nav_trigger_normal }}" data-action="click->dropdown#toggle">
                            {{ category.label }} <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute lg:absolute top-full right-0 lg:left-0 lg:right-auto bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[180px] py-2 z-20">
                            {% for item in category.items %}
                                <a class="{{ item.active ? nav_item_active : nav_item_normal }}" href="{{ path(item.route) }}" data-turbo="false">{{ item.label }}</a>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>


            <div class="flex items-center gap-4 mt-4 lg:mt-0">
                {% if app.user %}
                    {% if is_granted('ROLE_MEMBER') %}
                    <!-- Online Users Indicator (links neben Logout) -->
                    {% set online_status = get_online_status() %}
                    <div class="relative group" data-controller="dropdown online-status" data-online-status-url-value="{{ path('app_online_status') }}">
                        <a class="nav-trigger cursor-pointer no-underline py-2 lg:py-0" 
                           data-action="click->dropdown#toggle" 
                           title="Eingeloggte Spieler in EVE Online">
                            <span class="relative flex h-2 w-2 mr-0.5">
                                <span data-online-status-target="ping" class="{{ online_status.userCount > 0 ? 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75' : 'hidden' }}"></span>
                                <span data-online-status-target="dot" class="relative inline-flex rounded-full h-2 w-2 {{ online_status.userCount > 0 ? 'bg-emerald-400' : 'bg-slate-500' }}"></span>
                            </span>
                            <span class="whitespace-nowrap flex items-center gap-1 text-sm font-semibold">
                                <span data-online-status-target="count" class="font-bold">{{ online_status.userCount }}</span>
                                <span data-online-status-target="label">{{ online_status.userCount == 1 ? 'User' : 'User' }} online</span>
                            </span>
                            <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                        </a>
                        
                        <!-- Dropdown showing online pilots / users -->
                        <div class="hidden group-[.is-active]:block lg:group-hover:block absolute top-full right-0 mt-2 bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[260px] max-w-[340px] p-3 z-30 text-xs">
                            <div class="flex items-center justify-between pb-2 mb-2 border-b border-eve-border/40 font-semibold text-eve-text">
                                <span class="flex items-center gap-1.5">
                                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <span>EVE Online Status</span>
                                </span>
                                <span data-online-status-target="charCount" class="text-[0.7rem] px-1.5 py-0.5 rounded bg-white/5 text-eve-text font-semibold">
                                    {{ online_status.characterCount }} {{ online_status.characterCount == 1 ? 'Charakter' : 'Charaktere' }}
                                </span>
                            </div>
                            
                            <div data-online-status-target="list" class="space-y-2 max-h-[260px] overflow-y-auto pr-1">
                                {% if online_status.users is empty %}
                                    <div class="text-eve-muted py-2 text-center italic">
                                        Keine verknüpften Spieler online
                                    </div>
                                {% else %}
                                    {% for u in online_status.users %}
                                        <div class="p-2 rounded bg-white/[0.03] border border-eve-border/30">
                                            <div class="font-bold text-eve-text flex items-center justify-between">
                                                <span>{{ u.username }}</span>
                                                <span class="text-[0.7rem] text-emerald-400 font-medium">online</span>
                                            </div>
                                            <div class="mt-1.5 pl-2 border-l border-eve-primary/40 space-y-0.5 text-[0.8rem]">
                                                {% for c in u.characters %}
                                                    <div class="py-0.5 text-slate-300 font-medium truncate">
                                                        {{ c.name }}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            
                            <div class="mt-2 pt-2 border-t border-eve-border/30 text-[0.7rem] text-eve-muted text-center flex items-center justify-center gap-1">
                                <span>⏱ Aktualisierung: alle 5 Min.</span>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    {% set profile_categories = get_navigation('profile') %}
                    {% if profile_categories is not empty %}
                        {% set profile_category = profile_categories|first %}
                        <!-- Profile Dropdown -->
                        <div class="relative group" data-controller="dropdown">
                            <a class="{{ profile_category.active ? nav_trigger_active : nav_trigger_normal }}" data-action="click->dropdown#toggle">
                                {{ app.user.username ?? profile_category.label }} <span class="text-[0.75rem] transition-transform duration-200 group-[.is-active]:rotate-180">▼</span>
                            </a>
                            <div class="hidden group-[.is-active]:block lg:group-hover:block absolute top-full right-0 bg-[#0d121ff2] border border-eve-border rounded-lg shadow-eve backdrop-blur-md min-w-[180px] py-2 z-30">
                                {% for item in profile_category.items %}
                                    <a class="{{ item.active ? nav_item_active : nav_item_normal }}" href="{{ path(item.route) }}" data-turbo="false">{{ item.label }}</a>
                                {% endfor %}
                                <a class="{{ nav_item_normal }} border-t border-eve-border/40 mt-1" href="{{ path('app_logout') }}">Logout</a>
                            </div>
                        </div>
                    {% else %}
                        <a class="cursor-pointer py-2 lg:py-0 font-medium text-eve-muted hover:text-eve-primary no-underline transition-colors duration-200" href="{{ path('app_logout') }}">
                            🚪 Logout
                        </a>
                    {% endif %}
                {% else %}
                    <div class="py-2 lg:py-0">
                        <a class="inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm px-4 py-2 shadow-eve transition-all duration-300 hover:-translate-y-0.5" href="{{ path('app_login') }}" data-turbo="false">
                            Login
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

