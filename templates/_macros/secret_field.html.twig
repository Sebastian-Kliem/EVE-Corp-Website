{# Input for a stored secret: the value is never rendered, only a hint with its last characters #}
{% macro input(name, hint, placeholder, inputClass, testTarget = null) %}
    <input type="password" id="{{ name }}" name="{{ name }}" value="" autocomplete="new-password"
           placeholder="{{ hint ? 'Gespeichert (endet auf ' ~ hint ~ '), leer lassen zum Beibehalten' : placeholder }}"
           class="{{ inputClass }}"{% if testTarget %} data-wanderer-connection-test-target="{{ testTarget }}"{% endif %}>
{% endmacro %}

{# Checkbox that clears a stored secret on save, only shown when one is stored #}
{% macro remove_checkbox(name, hint) %}
    {% if hint %}
        <label class="mt-1.5 flex items-center gap-2 text-[11px] text-eve-muted cursor-pointer">
            <input type="checkbox" name="remove_settings[]" value="{{ name }}" class="accent-rose-500">
            Gespeicherten Wert entfernen
        </label>
    {% endif %}
{% endmacro %}
