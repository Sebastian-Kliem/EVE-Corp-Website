{% extends 'base.html.twig' %}

{% block title %}Anpassungsvorschläge{% endblock %}

{% block body %}
<div class="w-full max-w-[1200px] mx-auto px-6 mt-12 mb-16">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-bold uppercase tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-eve-primary to-purple-400">
            Anpassungsvorschläge
        </h1>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="border border-eve-border bg-eve-card rounded-lg p-5 mb-6 relative {{ label == 'error' ? 'bg-red-500/10 border-red-500/30 text-red-400' : (label == 'danger' ? 'bg-red-500/10 border-red-500/30 text-red-400' : 'bg-green-500/10 border-green-500/30 text-green-400') }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Create Suggestion Details Box -->
    <details class="bg-eve-card border border-eve-border shadow-eve rounded-lg overflow-hidden mb-6 max-w-[720px] group" {% if app.request.method == 'POST' and not app.session.flashBag.has('success') %}open{% endif %}>
        <summary class="cursor-pointer select-none flex justify-between items-center p-5 font-semibold list-none hover:bg-white/5 transition-colors duration-200">
            <span>Neuen Vorschlag einreichen</span>
            <span class="text-eve-primary transition-transform duration-300 group-open:rotate-180">▼</span>
        </summary>
        <div class="border-t border-eve-border p-6 bg-black/15">
            <form action="{{ path('app_suggestions') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('create_suggestion') }}">

                <div class="flex flex-col gap-2 mb-4">
                    <label for="title" class="text-sm font-semibold text-white">Überschrift:</label>
                    <input 
                        type="text" 
                        id="title" 
                        name="title" 
                        class="rounded-lg w-full px-3 py-2 text-base border border-eve-border text-eve-text bg-[#0f172a59] focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300" 
                        required 
                        placeholder="Z. B. Hangar-Filterung verfeinern"
                    >
                </div>

                <div class="flex flex-col gap-2 mb-4 mt-3">
                    <label for="description" class="text-sm font-semibold text-white">Beschreibung:</label>
                    <textarea 
                        id="description" 
                        name="description" 
                        class="rounded-lg w-full px-3 py-2 text-base border border-eve-border text-eve-text bg-[#0f172a59] focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300 resize-y" 
                        required 
                        rows="4"
                        placeholder="Beschreibe deinen Vorschlag möglichst genau..."
                    ></textarea>
                </div>

                <div class="mt-6">
                    <button type="submit" name="submit_suggestion" class="inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm px-4 py-2.5 shadow-eve transition-all duration-300 hover:-translate-y-0.5 cursor-pointer">
                        🚀 Vorschlag absenden
                    </button>
                </div>
            </form>
        </div>
    </details>

    <!-- Suggestions Table -->
    <div class="overflow-x-auto w-full border border-eve-border rounded-lg bg-eve-card/30 shadow-eve">
        <table class="w-full border-collapse">
            <thead>
                <tr class="border-b border-eve-border bg-[#0d121fe6]/50">
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm" style="width: 120px;">Status</th>
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm">Überschrift</th>
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm">Beschreibung</th>
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm">Erstellt von</th>
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm" style="width: 150px;">Datum</th>
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm" style="width: 100px;"></th>
                    <th class="text-left font-semibold text-eve-muted p-3 text-sm" style="width: 100px;"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
            {% for suggestion in suggestions %}
                {% if editing_suggestion and editing_suggestion.id == suggestion.id %}
                    <!-- Editing Mode -->
                    <form id="edit_form_{{ suggestion.id }}" action="{{ path('app_suggestions_update', {'id': suggestion.id}) }}" method="post" class="hidden"></form>
                    <tr class="bg-eve-primary/5">
                        <td class="p-3 text-sm" data-label="Status">
                            {% if suggestion.isCompleted %}
                                <span class="text-green-400 font-semibold">✓ erledigt</span>
                            {% else %}
                                <span class="text-eve-muted">offen</span>
                            {% endif %}
                        </td>
                        <td class="p-3 text-sm" data-label="Überschrift">
                            <input type="hidden" name="_token" value="{{ csrf_token('update_' ~ suggestion.id) }}" form="edit_form_{{ suggestion.id }}">
                            <input class="rounded-lg w-full px-3 py-1.5 text-base border border-eve-border text-eve-text bg-[#0f172a59] focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300" type="text" name="title" value="{{ suggestion.title }}" form="edit_form_{{ suggestion.id }}" required>
                        </td>
                        <td class="p-3 text-sm" data-label="Beschreibung">
                            <textarea class="rounded-lg w-full px-3 py-1.5 text-base border border-eve-border text-eve-text bg-[#0f172a59] focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300 resize-y" name="description" rows="3" form="edit_form_{{ suggestion.id }}" required>{{ suggestion.description }}</textarea>
                        </td>
                        <td class="p-3 text-sm" data-label="Erstellt von">
                            {{ suggestion.user.displayName }}
                        </td>
                        <td class="p-3 text-sm" data-label="Datum">
                            {{ suggestion.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="p-3 text-sm">
                            <button type="submit" form="edit_form_{{ suggestion.id }}" class="inline-flex items-center justify-center rounded bg-green-500 hover:bg-green-600 text-white font-medium text-xs px-3 py-1.5 cursor-pointer transition-colors duration-200">Speichern</button>
                        </td>
                        <td class="p-3 text-sm">
                            <a href="{{ path('app_suggestions') }}" class="inline-flex items-center justify-center rounded bg-white/10 hover:bg-white/20 text-white font-medium text-xs px-3 py-1.5 cursor-pointer no-underline transition-colors duration-200">Abbrechen</a>
                        </td>
                    </tr>
                {% else %}
                    <!-- Normal Mode -->
                    <tr class="hover:bg-white/2 transition-colors duration-150 odd:bg-white/[0.01] {% if suggestion.isCompleted %}opacity-60{% endif %}">
                        <td class="p-3 text-sm" data-label="Status">
                            {% if isAdmin %}
                                <form id="toggle_form_{{ suggestion.id }}" action="{{ path('app_suggestions_toggle', {id: suggestion.id}) }}" method="POST" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_' ~ suggestion.id) }}">
                                    <label class="inline-flex items-center gap-1.5 cursor-pointer text-sm text-eve-muted hover:text-white select-none">
                                        <input type="checkbox" onChange="this.form.submit()" {% if suggestion.isCompleted %}checked{% endif %} class="cursor-pointer w-4 h-4 accent-eve-primary">
                                        <span>Erledigt</span>
                                    </label>
                                </form>
                            {% else %}
                                {% if suggestion.isCompleted %}
                                    <span class="text-green-400 font-semibold">✓ erledigt</span>
                                {% else %}
                                    <span class="text-eve-muted">offen</span>
                                {% endif %}
                            {% endif %}
                        </td>
                        <td class="p-3 text-sm" data-label="Überschrift">
                            <span class="font-semibold {% if suggestion.isCompleted %}line-through text-eve-muted{% else %}text-white{% endif %}">
                                {{ suggestion.title }}
                            </span>
                        </td>
                        <td class="p-3 text-sm" data-label="Beschreibung">
                            <p class="whitespace-pre-line {% if suggestion.isCompleted %}text-eve-muted{% else %}text-eve-text{% endif %}">
                                {{ suggestion.description }}
                            </p>
                        </td>
                        <td class="p-3 text-sm" data-label="Erstellt von">
                            {{ suggestion.user.displayName }}
                        </td>
                        <td class="p-3 text-sm" data-label="Datum">
                            {{ suggestion.createdAt|date('d.m.Y H:i') }}
                        </td>
                        <td class="p-3 text-sm">
                            {% if suggestion.user == app.user or isAdmin %}
                                <a class="inline-flex items-center justify-center rounded bg-white/10 hover:bg-white/20 text-white font-medium text-xs px-3 py-1.5 cursor-pointer no-underline transition-colors duration-200" href="{{ path('app_suggestions', {edit_suggestion: suggestion.id}) }}">
                                    Bearbeiten
                                </a>
                            {% endif %}
                        </td>
                        <td class="p-3 text-sm">
                            {% if suggestion.user == app.user or isAdmin %}
                                <form action="{{ path('app_suggestions_delete', {id: suggestion.id}) }}" method="POST" onsubmit="return confirm('Möchtest du diesen Vorschlag wirklich löschen?');" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ suggestion.id) }}">
                                    <button type="submit" class="inline-flex items-center justify-center rounded bg-red-500 hover:bg-red-600 text-white font-medium text-xs px-3 py-1.5 cursor-pointer transition-colors duration-200">
                                        Löschen
                                    </button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endif %}
            {% else %}
                <tr>
                    <td colspan="7" class="text-center text-eve-muted p-8">
                        Es wurden bisher keine Anpassungsvorschläge eingereicht.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
