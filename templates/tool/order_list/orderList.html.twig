{% extends 'base.html.twig' %}

{% block title %}Orders & Bestellungen - WH-Toolbox{% endblock %}

{% block body %}
    <div class="w-full px-6 mt-8 mb-16">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-2xl font-bold text-white tracking-tight">Corp Orders & Aufträge</h1>
                <p class="text-xs text-eve-muted mt-1">Multi-Item Bestellungen, Fittings, Hangar-Buybacks und automatische Ingame-Vertragsabwicklung</p>
            </div>
            <div class="flex items-center gap-3">
                <a href="{{ path('app_corp_appraisal') }}" class="px-4 py-2 rounded-lg text-xs font-semibold border border-white/10 bg-[#0a0f1d] hover:bg-white/5 text-slate-300 hover:text-white transition-all cursor-pointer">
                    Janice Rechner öffnen
                </a>
            </div>
        </div>

        {{ react_component('OrderListManager', {
            'initialBuyOrders': initialBuyOrders,
            'initialSellOrders': initialSellOrders,
            'initialArchivedBuyOrders': initialArchivedBuyOrders,
            'initialArchivedSellOrders': initialArchivedSellOrders,
            'doctrineFits': doctrineFits,
            'currentUserId': app.user ? app.user.id : null,
            'isOfficer': is_granted('ROLE_OFFICER')
        }) }}
    </div>
{% endblock %}
