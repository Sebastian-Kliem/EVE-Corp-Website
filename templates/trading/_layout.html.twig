{% extends 'base.html.twig' %}

{# Shared frame of the trading pages, each page sets the heading, the description and the React component #}
{% block body %}
{% set reactProps = {
    urls: {
        context: path('app_trading_context'),
        settings: path('app_trading_settings'),
        station: path('app_trading_station'),
        item: path('app_trading_item'),
        myOrders: path('app_trading_my_orders'),
        performance: path('app_trading_performance'),
        performanceItem: path('app_trading_performance_item'),
        openMarket: path('app_trading_open_market')
    },
    typeIconUrl: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' })
} %}

<div class="w-full px-6 mt-8 mb-12">
    <div class="mb-6">
        <h1 class="text-3xl font-semibold text-white mb-0 text-gradient">{% block heading %}{% endblock %}</h1>
        <p class="text-xs text-eve-muted mt-1">{% block description %}{% endblock %}</p>
    </div>

    <div data-react-component="{% block react_component %}{% endblock %}" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
