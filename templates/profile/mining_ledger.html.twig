{% extends 'base.html.twig' %}

{% block title %}Bergbaudagebuch{% endblock %}

{% block body %}
{% set reactProps = {
    charactersList: charactersList,
    apiDataUrl: path('app_dashboard_mining_data'),
    imagePaths: {
        types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
        characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
    }
} %}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-0">Bergbaudagebuch</h1>
            <p class="text-muted">Übersicht der Bergbau-Aktivitäten der letzten 90 Tage.</p>
        </div>
    </div>

    <div data-react-component="MiningLedger" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
