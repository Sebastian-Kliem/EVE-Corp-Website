{% extends 'base.html.twig' %}

{% block title %}Marktaufträge & Marktstand{% endblock %}

{% block body %}
{% set reactProps = {
    apiDataUrl: path('app_dashboard_market_data'),
    imagePaths: {
        types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
        characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
    }
} %}

<div class="w-full max-w-[1200px] mx-auto px-6 mt-8 mb-12">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-semibold text-white mb-0 text-gradient">Eigene Marktaufträge</h1>
            <p class="text-xs text-eve-muted mt-1">Übersicht deiner aktiven Kauf- und Verkaufsaufträge im Vergleich zum aktuellen Marktstand an der jeweiligen Station.</p>
        </div>
    </div>

    <div data-react-component="MarketOrdersOverview" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
