{% extends 'base.html.twig' %}

{% block title %}Gesamt-Inventar & Wallet{% endblock %}

{% block body %}
{% import _self as macros %}

<div class="container mt-5 mb-6">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb" aria-label="breadcrumbs">
        <ul>
            <li><a href="{{ path('app_profile') }}" style="color: var(--color-primary, #ffd700);">👤 Profil</a></li>
            <li class="is-active"><a href="#" aria-current="page" class="has-text-grey-light">🎒 Gesamt-Inventar & Wallet</a></li>
        </ul>
    </nav>

    <!-- Header & Combined Wallet Balance -->
    <div class="box p-5 mb-5" style="background: linear-gradient(135deg, rgba(238, 120, 32, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%); border: 1px solid #333; border-radius: 8px; position: relative; overflow: hidden;">
        <div style="position: absolute; right: -20px; bottom: -30px; font-size: 10rem; opacity: 0.03; pointer-events: none; color: #fff; font-weight: bold;">ISK</div>
        <div class="columns is-vcentered">
            <div class="column">
                <span class="has-text-grey-light is-size-6 uppercase-tracking">Gesamtguthaben aller Accounts</span>
                <h1 class="title is-1 mt-1" style="color: #00ffaa; font-weight: 800; font-family: monospace;">
                    {{ totalWallet|number_format(2, ',', '.') }} <span class="is-size-3">ISK</span>
                </h1>
            </div>
            <div class="column is-narrow">
                <div class="field">
                    <div class="control has-icons-left">
                        <input id="global-asset-search" class="input" type="text" placeholder="Gegenstände suchen..." style="background: #1a1a1a; color: #fff; border-color: #444; width: 260px;">
                        <span class="icon is-small is-left">
                            🔍
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Character Accordion Panels -->
    {% if characterData is empty %}
        <div class="notification is-info">
            Bisher sind keine EVE Online Charaktere mit diesem Account verknüpft. Bitte verknüpfe einen Charakter über EVE SSO auf deinem Profil.
        </div>
    {% else %}
        {% for data in characterData %}
            <div class="box mb-5 character-panel-box" style="background-color: rgba(255, 255, 255, 0.01); border: 1px solid #333; border-radius: 6px; padding: 0;">
                <!-- Panel Header -->
                <div class="p-4 is-flex is-justify-content-space-between is-align-items-center character-panel-header" data-char-id="{{ data.character.id }}" style="cursor: pointer; background: rgba(0,0,0,0.15); border-bottom: 1px solid #2a2a2a; border-radius: 6px 6px 0 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                    <div class="is-flex is-align-items-center" style="display: flex; align-items: center; gap: 12px;">
                        <figure class="image is-32x32 m-0">
                            <img src="{{ path('app_eve_image_proxy', { category: 'characters', id: data.character.id, action: 'portrait' }) }}?size=64" alt="{{ data.character.name }}" class="is-rounded" style="border-radius: 50%;">
                        </figure>
                        <div>
                            <span class="has-text-weight-bold is-size-5" style="color: #fff;">{{ data.character.name }}</span>
                            <span class="has-text-grey ml-2 is-size-7">ID: {{ data.character.id }}</span>
                        </div>
                    </div>
                    <div class="has-text-right">
                        <span class="is-size-5 has-text-weight-bold" style="color: #00ffaa; font-family: monospace;">
                            {{ data.walletBalance|number_format(2, ',', '.') }} ISK
                        </span>
                        <span class="is-size-7 has-text-grey block" style="display: block;">
                            Stand: {% if data.character.lastAssetsUpdate is not null %}{{ data.character.lastAssetsUpdate|date('d.m.Y H:i') }} Uhr{% else %}nie{% endif %}
                        </span>
                    </div>
                </div>

                <!-- Panel Content (Asset List) -->
                <div class="character-panel-content character-assets-panel-content" id="char-assets-{{ data.character.id }}">
                    {% if data.locations is empty %}
                        <p class="has-text-grey has-text-centered py-4">Bisher keine Inventar-Daten für diesen Charakter vorhanden. Der Cron-Job läuft im Hintergrund.</p>
                    {% else %}
                        {% for location in data.locations %}
                            <div class="location-block" data-location-name="{{ location.name|e('html_attr') }}">
                                <h3 class="title is-6 location-header">
                                    <span class="location-header-title">
                                        <span>{{ location.name }}</span>
                                    </span>
                                    <span class="tag is-dark is-rounded is-small font-family-monospace location-header-tag">
                                        {{ location.items|length }} Top-Level
                                    </span>
                                </h3>

                                <div class="asset-tree location-assets-container" style="display: none;">
                                    {% for item in location.items %}
                                        {{ macros.render_asset_node(item) }}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>

<!-- Recursive Twig Macro to render nested assets (ships, containers etc) -->
{% macro render_asset_node(item) %}
    <div class="asset-tree-node" data-item-name="{{ item.name|e('html_attr') }}">
        <div class="py-1 asset-header-row {% if item.children is not empty %}has-children{% endif %}">
            <img src="{{ path('app_eve_image_proxy', { category: 'types', id: item.typeId, action: 'icon' }) }}?size=32" alt="{{ item.name }}" class="asset-item-icon">
            
            <div class="asset-item-details">
                <div class="asset-item-name-row">
                    <span class="asset-item-name">
                        {{ item.name }}
                    </span>
                    {% if item.isBlueprintCopy %}
                        <span class="tag is-info is-light is-small asset-item-tag">Kopie</span>
                    {% elseif item.isSingleton and not item.isBlueprintCopy %}
                        <span class="tag is-dark is-small asset-item-tag">Modifiziert</span>
                    {% endif %}
                </div>
                <div class="asset-item-info-row">
                    <span class="asset-item-quantity">
                        x{{ item.quantity|number_format(0, ',', '.') }}
                    </span>
                    <span class="asset-item-flag">
                        {{ item.locationFlag }}
                    </span>
                </div>
            </div>
        </div>

        {% if item.children is not empty %}
            <div class="nested-children-container" style="display: none;">
                {% for child in item.children %}
                    {{ _self.render_asset_node(child) }}
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}

<script>
document.addEventListener('DOMContentLoaded', () => {
    // 1. Accordion Toggle for Character Panels
    const headers = document.querySelectorAll('.character-panel-header');
    headers.forEach(header => {
        header.addEventListener('click', () => {
            const charId = header.getAttribute('data-char-id');
            const content = document.getElementById(`char-assets-${charId}`);

            if (content.style.display === 'none') {
                content.style.display = 'block';
            } else {
                content.style.display = 'none';
            }
        });
    });

    // 1b. Accordion Toggle for Location Headers (Stations)
    const locationHeaders = document.querySelectorAll('.location-header');
    locationHeaders.forEach(locHeader => {
        locHeader.addEventListener('click', () => {
            const block = locHeader.closest('.location-block');
            const container = block.querySelector('.location-assets-container');

            if (container.style.display === 'none') {
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
            }
        });
    });

    // 2. Expand/Collapse for Nested Items (Containers/Ships)
    document.addEventListener('click', (e) => {
        const headerRow = e.target.closest('.asset-header-row');
        if (headerRow) {
            const node = headerRow.closest('.asset-tree-node');
            const container = node.querySelector('.nested-children-container');
            if (container) {
                e.stopPropagation();
                if (container.style.display === 'none') {
                    container.style.display = 'block';
                } else {
                    container.style.display = 'none';
                }
            }
        }
    });

    // 3. Global Search & Filter
    const searchInput = document.getElementById('global-asset-search');
    if (searchInput) {
        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            const locationBlocks = document.querySelectorAll('.location-block');

            locationBlocks.forEach(block => {
                const locContainer = block.querySelector('.location-assets-container');
                let matchesInBlock = 0;
                const nodes = block.querySelectorAll('.asset-tree-node');

                nodes.forEach(node => {
                    const itemName = node.getAttribute('data-item-name').toLowerCase();
                    const nestedContainer = node.querySelector('.nested-children-container');

                    if (query === '') {
                        // Reset all to default (nested containers closed, nodes visible)
                        node.style.display = '';
                        if (nestedContainer) {
                            nestedContainer.style.display = 'none';
                        }
                    } else {
                        // Check if this node itself matches the query
                        const isMatch = itemName.includes(query);

                        if (isMatch) {
                            node.style.display = '';
                            matchesInBlock++;

                            // If it matches, show parent container line and make sure parents are expanded
                            let parent = node.parentElement.closest('.asset-tree-node');
                            while (parent) {
                                parent.style.display = '';
                                const parentContainer = parent.querySelector('.nested-children-container');
                                if (parentContainer) {
                                    parentContainer.style.display = 'block';
                                }
                                parent = parent.parentElement.closest('.asset-tree-node');
                            }
                        } else {
                            // If it doesn't match, check if any of its children match
                            const childrenMatch = node.querySelectorAll(`[data-item-name*="${query}"]`).length > 0;
                            if (childrenMatch) {
                                node.style.display = '';
                                if (nestedContainer) {
                                    nestedContainer.style.display = 'block';
                                }
                                matchesInBlock++;
                            } else {
                                node.style.display = 'none';
                            }
                        }
                    }
                });

                // Show/hide location block and auto-expand on search matching
                if (query === '') {
                    block.style.display = '';
                    if (locContainer) {
                        locContainer.style.display = 'none';
                    }
                } else {
                    if (matchesInBlock > 0) {
                        block.style.display = '';
                        if (locContainer) {
                            locContainer.style.display = 'block';
                        }
                    } else {
                        block.style.display = 'none';
                    }
                }
            });

            // Automatically open character panel if it contains matches
            const panels = document.querySelectorAll('.character-panel-box');
            panels.forEach(panel => {
                const header = panel.querySelector('.character-panel-header');
                const content = panel.querySelector('.character-panel-content');
                const hasVisibleBlocks = Array.from(content.querySelectorAll('.location-block')).some(b => b.style.display !== 'none');

                if (query !== '') {
                    if (hasVisibleBlocks) {
                        content.style.display = 'block';
                        panel.style.display = '';
                    } else {
                        panel.style.display = 'none';
                    }
                } else {
                    panel.style.display = '';
                }
            });
        });
    }
});
</script>
{% endblock %}
