{% extends 'base.html.twig' %}

{% block title %}Mein Profil{% endblock %}

{% block body %}
<div class="container container-narrow mt-5 mb-6">
    <!-- Headline -->
    <h1 class="title is-2 text-gradient">
        Mein Profil
    </h1>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="notification is-success">
            ✔️ {{ message }}
        </div>
    {% endfor %}

    <!-- Profile Details Box -->
    <details class="box mt-5" {% if errors is not empty %}open{% endif %}>
        <summary>👤 User-Profil</summary>
        <div class="details-content">
            <div class="form-group">
                <label>Username</label>
                <span class="is-size-6 has-text-grey-light">{{ user.username }}</span>
            </div>

            {% if not is_granted('ROLE_MEMBER') %}
                <div class="form-group mt-4">
                    <label>Zugriffsstatus</label>
                    <div class="notification is-warning mb-0">
                        Dein Account ist noch nicht freigeschaltet. Bitte wende dich an einen Corp-Officer oder Administrator, um verifiziert zu werden.
                    </div>
                </div>
            {% endif %}

            <!-- Password Change Form Box -->
            <details class="profile-details-wrapper mt-4" {% if errors is not empty %}open{% endif %}>
                <summary class="profile-details-summary">🔑 Passwort ändern</summary>
                <div class="mt-3">
                    <!-- Errors -->
                    {% if errors is not empty %}
                        <div class="notification is-danger mt-3">
                            <ul>
                                {% for error in errors %}
                                    <li>❌ {{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <form action="{{ path('app_profile') }}" method="POST" class="mt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                        <!-- Current Password -->
                        <div class="form-group">
                            <label for="current_password">Aktuelles Passwort</label>
                            <input type="password" id="current_password" name="current_password" required placeholder="Dein aktuelles Passwort...">
                            <p class="has-text-grey-light is-size-7 mt-1">Wird zur Verifizierung benötigt (auch bei temporären Passwörtern).</p>
                        </div>

                        <!-- New Password -->
                        <div class="form-group mt-4">
                            <label for="new_password">Neues Passwort</label>
                            <input type="password" id="new_password" name="new_password" required placeholder="Mindestens 6 Zeichen...">
                        </div>

                        <!-- New Password Confirm -->
                        <div class="form-group mt-4">
                            <label for="new_password_confirm">Neues Passwort wiederholen</label>
                            <input type="password" id="new_password_confirm" name="new_password_confirm" required placeholder="Neues Passwort bestätigen...">
                        </div>

                        <!-- Submit button -->
                        <button type="submit" class="button is-primary is-fullwidth mt-5">
                            Passwort aktualisieren
                        </button>
                    </form>
                </div>
            </details>
        </div>
    </details>

    <!-- Persönliche Corp-Assets Einstellungen -->
    <details class="box mt-5">
        <summary>💼 Persönliche Corp-Assets (Hangare & Container)</summary>
        <div class="details-content">
            <p class="is-size-7 has-text-grey-light mb-4">
                Hier kannst du Corp-Hangare oder darin liegende Container markieren, damit deren Inhalt zu deinem persönlichen Vermögen und deinen Assets hinzugerechnet wird. 
                Es stehen nur Hangare und Container zur Auswahl, für deren Corporationen du mindestens einen verknüpften Charakter besitzt.
            </p>

            <form action="{{ path('app_profile_personal_assets') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('update_personal_assets') }}">

                <!-- Corp Hangars Section -->
                <h3 class="title is-6 mb-2 text-gradient">🏢 Corporation Hangare</h3>
                {% if availableHangars is not empty %}
                    <div class="field mb-5" style="max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; border: 1px solid var(--theme-card-border);">
                        {% for hangar in availableHangars %}
                            {% set isChecked = false %}
                            {% for config in user.personalCorpHangars %}
                                {% if config.corporationId == hangar.corpId and config.locationId == hangar.locationId and config.locationFlag == hangar.locationFlag %}
                                    {% set isChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <div class="control mb-2">
                                <label class="checkbox has-text-grey-light" style="display: flex; align-items: center; cursor: pointer;">
                                    <input type="checkbox" name="hangars[]" value="{{ hangar.id }}" {% if isChecked %}checked{% endif %} class="mr-2" style="cursor: pointer;">
                                    <span>
                                        <strong>{{ hangar.locationName }}</strong> - <span class="has-text-info">{{ hangar.divisionName }}</span>
                                    </span>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="is-size-7 has-text-grey mb-4">Keine verfügbaren Corporation-Hangare gefunden.</p>
                {% endif %}

                <!-- Corp Containers Section -->
                <h3 class="title is-6 mb-2 text-gradient">📦 Container in Corp-Hangaren</h3>
                {% if availableContainers is not empty %}
                    <div class="field mb-5" style="max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; border: 1px solid var(--theme-card-border);">
                        {% for container in availableContainers %}
                            {% set isChecked = false %}
                            {% for config in user.personalCorpContainers %}
                                {% if config.corporationId == container.corpId and config.itemId == container.itemId %}
                                    {% set isChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <div class="control mb-2">
                                <label class="checkbox has-text-grey-light" style="display: flex; align-items: center; cursor: pointer;">
                                    <input type="checkbox" name="containers[]" value="{{ container.id }}" {% if isChecked %}checked{% endif %} class="mr-2" style="cursor: pointer;">
                                    <span>
                                        <strong>{{ container.name }}</strong> (in {{ container.locationName }} - <span class="has-text-info">{{ container.locationFlag }}</span>)
                                    </span>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="is-size-7 has-text-grey mb-4">Keine verfügbaren Container in Corporation-Hangaren gefunden.</p>
                {% endif %}

                <button type="submit" class="button is-primary is-fullwidth mt-4">
                    Einstellungen speichern
                </button>
            </form>
        </div>
    </details>

    <!-- EVE Online Accounts & Characters Box -->
    <details class="box mt-5">
        <summary>🚀 EVE Online Accounts & Charaktere</summary>
        <div class="details-content">
            <div class="is-flex is-justify-content-end is-align-items-center mb-4 profile-eve-heading">
                <div class="profile-char-actions mb-0">
                    <a href="{{ path('app_eve_sso_login') }}" class="button is-primary is-small">
                        ➕ EVE Charakter hinzufügen
                    </a>
                </div>
            </div>

            <!-- Neuen Account anlegen Form -->
            <details class="mb-5 profile-details-wrapper">
                <summary class="profile-details-summary">
                    <span>🛠️</span> Neuen Account-Ordner anlegen
                </summary>
                <form action="{{ path('app_eve_account_create') }}" method="POST" class="mt-3 profile-form-horizontal">
                    <input type="hidden" name="_token" value="{{ csrf_token('eve_account_create') }}">
                    <div class="profile-form-flex-grow">
                        <label class="profile-input-label-small">Account-Name (z.B. "Main Account")</label>
                        <input type="text" name="name" required placeholder="Name eingeben..." class="profile-input-small">
                    </div>
                    <button type="submit" class="button is-link is-small profile-button-height">Erstellen</button>
                </form>
            </details>

            <!-- Gruppe: Nicht zugewiesene Charaktere -->
            {% if unassignedCharacters is not empty %}
                <div class="box p-4 mb-4 profile-unassigned-box">
                    <div class="mb-3">
                        <span class="has-text-weight-bold is-size-5 profile-unassigned-title">
                            ⚠️ Nicht zugewiesene Charaktere
                        </span>
                        <p class="is-size-7 has-text-grey mt-1">Hier landen frisch hinzugefügte Charaktere. Weise sie unten einem Account zu.</p>
                    </div>

                    <div class="columns is-multiline">
                        {% for char in unassignedCharacters %}
                            <div class="column is-4">
                                <div class="p-3 profile-char-card">
                                    <div class="is-flex is-align-items-center mb-3">
                                        <figure class="image is-32x32 mr-3 profile-char-figure">
                                            <img src="{{ path('app_eve_image_proxy', { category: 'characters', id: char.id, action: 'portrait' }) }}?size=64" alt="{{ char.name }}" class="is-rounded profile-char-avatar">
                                        </figure>
                                        <div>
                                            <div class="has-text-weight-semibold is-size-6 profile-char-name">{{ char.name }}</div>
                                            <div class="is-size-7 has-text-grey">ID: {{ char.id }}</div>
                                        </div>
                                    </div>

                                    <!-- Wallet Balance & Sync Status -->
                                    <div class="is-size-7 mt-2 mb-2 profile-char-wallet-row">
                                        <div class="profile-char-wallet-flex">
                                            <span class="profile-char-wallet-label">Wallet:</span>
                                            <span class="has-text-weight-semibold profile-char-wallet-value">
                                                {% if char.walletBalance is not null %}
                                                    {{ char.walletBalance|number_format(2, ',', '.') }} ISK
                                                {% else %}
                                                    <span class="profile-char-wallet-none">Keine Daten</span>
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>

                                    <div class="profile-char-actions">
                                        <a href="{{ path('app_dashboard_eve_character_assets', { id: char.id }) }}" class="button is-dark is-small profile-char-button-small">
                                            🎒 Inventar
                                        </a>
                                        <form action="{{ path('app_eve_character_delete', { id: char.id }) }}" method="POST" class="cron-inline-form" onsubmit="return confirm('Möchtest du den Charakter \'{{ char.name|e('js') }}\' wirklich vollständig aus der Anwendung entfernen?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('eve_character_delete_' ~ char.id) }}">
                                            <button type="submit" class="button is-danger is-small profile-char-button-delete" title="Charakter entfernen">
                                                ❌
                                            </button>
                                        </form>
                                    </div>
                                    
                                    <!-- Zuweisungs-Formular -->
                                    <details class="profile-char-assign-details">
                                        <summary class="profile-char-assign-summary">🔄 Account zuweisen</summary>
                                        <form action="{{ path('app_eve_character_assign', { id: char.id }) }}" method="POST" class="mt-2">
                                            <input type="hidden" name="_token" value="{{ csrf_token('eve_character_assign_' ~ char.id) }}">
                                            <div class="select is-small is-fullwidth">
                                                <select name="accountId" onchange="this.form.submit()" class="profile-char-assign-select">
                                                    <option value="unassigned" selected>-- Account auswählen --</option>
                                                    {% for account in user.eveAccounts %}
                                                        <option value="{{ account.id }}">{{ account.name }}</option>
                                                    {% endfor %}
                                                </select>
                                            </div>
                                        </form>
                                    </details>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <!-- Liste der Accounts nach Gruppen -->
            {% if user.eveAccounts is empty and unassignedCharacters is empty %}
                <div class="notification is-info mt-3">
                    Bisher sind keine EVE Online Charaktere mit diesem Account verknüpft. Klicke auf "EVE Charakter hinzufügen", um einen EVE Charakter über EVE SSO zu verbinden.
                </div>
            {% else %}
                {% for groupName, accounts in groupedAccounts %}
                    <div class="mb-6">
                        <h3 class="title is-5 mb-3 profile-group-heading">
                            🏷️ {{ groupName }}
                            <span class="tag is-rounded is-small profile-group-tag">
                                {{ accounts|length }} {{ accounts|length == 1 ? 'Account' : 'Accounts' }}
                            </span>
                        </h3>

                        {% for account in accounts %}
                            <div class="box p-4 mb-4 profile-account-box">
                                
                                <!-- Account Kopfzeile mit Einstellungen -->
                                <div class="profile-account-header">
                                    <div>
                                        <span class="has-text-weight-bold is-size-5 profile-account-title">
                                            📂 {{ account.name }}
                                            {% if account.isOmega %}
                                                <span class="tag is-warning">Omega</span>
                                            {% else %}
                                                <span class="tag is-dark">Alpha</span>
                                            {% endif %}
                                        </span>
                                    </div>
                                    
                                    <!-- Account bearbeiten dropdown/toggle -->
                                    <details class="profile-account-details">
                                        <summary class="profile-account-summary">⚙️ Einstellungen</summary>
                                        <div class="mt-3 cron-edit-form-container">
                                            <form action="{{ path('app_eve_account_update', { id: account.id }) }}" method="POST" class="mb-3">
                                                <input type="hidden" name="_token" value="{{ csrf_token('eve_account_update_' ~ account.id) }}">
                                                
                                                <div class="field mb-2 profile-form-field">
                                                    <label class="label is-small profile-form-label">Name</label>
                                                    <input class="input is-small profile-form-input" type="text" name="name" value="{{ account.name }}" required>
                                                </div>
                                                
                                                <div class="field mb-2 profile-form-field">
                                                    <label class="label is-small profile-form-label">Gruppe / Cluster</label>
                                                    <input class="input is-small profile-form-input" type="text" name="groupName" value="{{ account.groupName }}" placeholder="z.B. Cynos, PI, Main...">
                                                </div>
                                                
                                                <div class="field mb-3 profile-form-checkbox-group">
                                                    <input type="checkbox" id="isOmega_{{ account.id }}" name="isOmega" value="1" {% if account.isOmega %}checked{% endif %}>
                                                    <label for="isOmega_{{ account.id }}" class="profile-form-checkbox-label">Omega Account</label>
                                                </div>
                                                
                                                <button type="submit" class="button is-success is-small is-fullwidth profile-form-button-full">Speichern</button>
                                            </form>
                                            
                                            <form action="{{ path('app_eve_account_delete', { id: account.id }) }}" method="POST" onsubmit="return confirm('Diesen Account wirklich löschen? Zugeordnete Charaktere werden dadurch nicht gelöscht, sondern werden unassigned.')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('eve_account_delete_' ~ account.id) }}">
                                                <button type="submit" class="button is-danger is-small is-fullwidth profile-form-button-full">❌ Account löschen</button>
                                            </form>
                                        </div>
                                    </details>
                                </div>

                                <!-- Charaktere in diesem Account -->
                                <div class="columns is-multiline">
                                    {% for char in account.characters %}
                                        <div class="column is-4">
                                            <div class="p-3 profile-char-card">
                                                <div class="is-flex is-align-items-center mb-3">
                                                    <figure class="image is-32x32 mr-3 profile-char-figure">
                                                        <img src="{{ path('app_eve_image_proxy', { category: 'characters', id: char.id, action: 'portrait' }) }}?size=64" alt="{{ char.name }}" class="is-rounded profile-char-avatar">
                                                    </figure>
                                                    <div>
                                                        <div class="has-text-weight-semibold is-size-6 profile-char-name">{{ char.name }}</div>
                                                        <div class="is-size-7 has-text-grey">ID: {{ char.id }}</div>
                                                    </div>
                                                </div>

                                                <!-- Wallet Balance & Sync Status -->
                                                <div class="is-size-7 mt-2 mb-2 profile-char-wallet-row">
                                                    <div class="profile-char-wallet-flex">
                                                        <span class="profile-char-wallet-label">Wallet:</span>
                                                        <span class="has-text-weight-semibold profile-char-wallet-value">
                                                            {% if char.walletBalance is not null %}
                                                                {{ char.walletBalance|number_format(2, ',', '.') }} ISK
                                                            {% else %}
                                                                <span class="profile-char-wallet-none">Keine Daten</span>
                                                            {% endif %}
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="profile-char-actions">
                                                    <a href="{{ path('app_dashboard_eve_character_assets', { id: char.id }) }}" class="button is-dark is-small profile-char-button-small">
                                                        🎒 Inventar
                                                    </a>
                                                    <form action="{{ path('app_eve_character_delete', { id: char.id }) }}" method="POST" class="cron-inline-form" onsubmit="return confirm('Möchtest du den Charakter \'{{ char.name|e('js') }}\' wirklich vollständig aus der Anwendung entfernen?')">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('eve_character_delete_' ~ char.id) }}">
                                                        <button type="submit" class="button is-danger is-small profile-char-button-delete" title="Charakter entfernen">
                                                            ❌
                                                        </button>
                                                    </form>
                                                </div>
                                                
                                                <!-- Zuweisungs-Formular -->
                                                <details class="profile-char-assign-details">
                                                    <summary class="profile-char-assign-summary">🔄 Account verschieben</summary>
                                                    <form action="{{ path('app_eve_character_assign', { id: char.id }) }}" method="POST" class="mt-2">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('eve_character_assign_' ~ char.id) }}">
                                                        <div class="select is-small is-fullwidth">
                                                            <select name="accountId" onchange="this.form.submit()" class="profile-char-assign-select">
                                                                {% for acc in user.eveAccounts %}
                                                                    <option value="{{ acc.id }}" {% if acc.id == account.id %}selected{% endif %}>{{ acc.name }}</option>
                                                                {% endfor %}
                                                                <option value="unassigned">-- Nicht zugewiesen --</option>
                                                            </select>
                                                        </div>
                                                    </form>
                                                </details>
                                            </div>
                                        </div>
                                     {% endfor %}
                                    
                                    {% if account.characters is empty %}
                                        <div class="column is-12">
                                            <p class="is-size-7 has-text-grey has-text-centered">Keine Charaktere in diesem Account. Weise einen unassigned Charakter oben diesem Account zu.</p>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </details>

    <!-- Custom Tracking Lists Box -->
    <details class="box mt-5" id="tracking-manager">
        <summary>📋 Custom Tracking-Listen</summary>
        <div class="details-content">
            <p class="subtitle is-6 has-text-grey-light mt-1">Erstelle persönliche Listen, verwalte Gegenstände oder kopiere System-Vorlagen. Die Einnahmen-Auswertung findest du unter "Persönlich -> Asset-Tracking".</p>
            
            {# React Island mount point #}
            <div data-react-component="TrackingListManager" data-react-props="{{ {'jwtToken': jwt_token(app.user)}|json_encode|e('html_attr') }}"></div>
        </div>
    </details>

</div>
{% endblock %}
