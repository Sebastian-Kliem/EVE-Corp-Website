{% extends 'base.html.twig' %}

{% block title %}Mein Profil{% endblock %}

{% block body %}
<div class="w-full max-w-[800px] mx-auto px-6 mt-10 mb-12">
    <!-- Headline -->
    <h1 class="text-3xl font-semibold mb-4 text-white text-gradient">
        Mein Profil
    </h1>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="py-5 px-6 rounded-lg mb-6 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
            ✔️ {{ message }}
        </div>
    {% endfor %}

    <!-- Profile Details Box -->
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mt-6 group" id="profile-details" {% if errors is not empty %}open{% endif %}>
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-lg text-white">
            <span>👤 User-Profil</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            <div class="flex flex-col gap-2 mb-5">
                <label class="font-semibold text-[0.95rem] text-white">Username</label>
                <span class="text-base text-eve-muted">{{ user.username }}</span>
            </div>

            {% if not is_granted('ROLE_MEMBER') %}
                <div class="flex flex-col gap-2 mb-5 mt-4">
                    <label class="font-semibold text-[0.95rem] text-white">Zugriffsstatus</label>
                    <div class="py-5 px-6 rounded-lg bg-amber-500/10 border border-amber-500/30 text-white mb-0">
                        Dein Account ist noch nicht freigeschaltet. Bitte wende dich an einen Corp-Officer oder Administrator, um verifiziert zu werden.
                    </div>
                </div>
            {% endif %}

            <!-- Password Change Form Box -->
            <details class="border border-dashed border-white/10 rounded-md p-3 bg-white/[0.01] mt-4 group" id="profile-password-edit" {% if errors is not empty %}open{% endif %}>
                <summary class="cursor-pointer font-bold text-eve-primary list-none flex justify-between items-center gap-1.5 select-none text-sm">
                    <span>🔑 Passwort ändern</span>
                    <span class="text-[10px] transition-transform duration-200 group-open:rotate-180">▼</span>
                </summary>
                <div class="mt-3">
                    <!-- Errors -->
                    {% if errors is not empty %}
                        <div class="py-5 px-6 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 mt-3">
                            <ul>
                                {% for error in errors %}
                                    <li>❌ {{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <form action="{{ path('app_profile') }}" method="POST" class="mt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                        <!-- Current Password -->
                        <div class="flex flex-col gap-2 mb-5">
                            <label for="current_password" class="font-semibold text-[0.95rem] text-white">Aktuelles Passwort</label>
                            <input type="password" id="current_password" name="current_password" required placeholder="Dein aktuelles Passwort..." class="w-full px-3 py-2 text-sm border rounded-lg bg-[#0f172a59] border-eve-border text-eve-text placeholder-eve-muted focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300">
                            <p class="text-eve-muted text-xs mt-1">Wird zur Verifizierung benötigt (auch bei temporären Passwörtern).</p>
                        </div>

                        <!-- New Password -->
                        <div class="flex flex-col gap-2 mb-5 mt-4">
                            <label for="new_password" class="font-semibold text-[0.95rem] text-white">Neues Passwort</label>
                            <input type="password" id="new_password" name="new_password" required placeholder="Mindestens 6 Zeichen..." class="w-full px-3 py-2 text-sm border rounded-lg bg-[#0f172a59] border-eve-border text-eve-text placeholder-eve-muted focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300">
                        </div>

                        <!-- New Password Confirm -->
                        <div class="flex flex-col gap-2 mb-5 mt-4">
                            <label for="new_password_confirm" class="font-semibold text-[0.95rem] text-white">Neues Passwort wiederholen</label>
                            <input type="password" id="new_password_confirm" name="new_password_confirm" required placeholder="Neues Passwort bestätigen..." class="w-full px-3 py-2 text-sm border rounded-lg bg-[#0f172a59] border-eve-border text-eve-text placeholder-eve-muted focus:outline-none focus:border-eve-primary focus:shadow-[0_0_10px_rgba(0,240,255,0.25)] transition-all duration-300">
                        </div>

                        <!-- Submit button -->
                        <button type="submit" class="w-full inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm py-2 shadow-eve transition-all duration-300 hover:-translate-y-0.5 cursor-pointer mt-5">
                            Passwort aktualisieren
                        </button>
                    </form>
                </div>
            </details>
        </div>
    </details>

    <!-- Webseiten- & Anzeige-Einstellungen -->
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mt-6 group" id="profile-site-settings" open>
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-lg text-white">
            <span>Webseiten- &amp; UI-Einstellungen</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            <p class="text-xs text-eve-muted mb-4">
                Hier kannst du persönliche Einstellungen zur Darstellung der Benutzeroberfläche festlegen.
            </p>

            <form action="{{ path('app_profile_update_settings') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('update_user_settings') }}">

                <!-- Seitenbreite / Layout -->
                <div class="mb-5">
                    <label class="block font-semibold text-sm text-white mb-2">Layout-Breite (Seitenbreite)</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label class="flex items-start gap-3 p-3.5 rounded-lg border border-eve-border bg-black/20 hover:border-eve-primary/50 cursor-pointer transition-colors">
                            <input type="radio" name="layout_width" value="standard" {% if not user.fluidLayout %}checked{% endif %} class="mt-1 cursor-pointer accent-eve-primary">
                            <div>
                                <strong class="block text-sm text-white">Standard (Zentriert)</strong>
                                <span class="text-xs text-eve-muted">Optimale Lesbarkeit mit maximal 1200px Inhaltsbreite.</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-3 p-3.5 rounded-lg border border-eve-border bg-black/20 hover:border-eve-primary/50 cursor-pointer transition-colors">
                            <input type="radio" name="layout_width" value="fluid" {% if user.fluidLayout %}checked{% endif %} class="mt-1 cursor-pointer accent-eve-primary">
                            <div>
                                <strong class="block text-sm text-white">Volle Breite (Fluid)</strong>
                                <span class="text-xs text-eve-muted">Nutzt die gesamte Monitorbreite für maximale Übersicht.</span>
                            </div>
                        </label>
                    </div>
                </div>

                <button type="submit" class="w-full inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm py-2.5 shadow-eve transition-all duration-300 hover:-translate-y-0.5 cursor-pointer mt-2">
                    Webseiten-Einstellungen speichern
                </button>
            </form>
        </div>
    </details>

    <!-- Blueprint-Tresor Freigabe-Einstellungen -->
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mt-6 group" id="profile-blueprint-sharing">
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-lg text-white">
            <span>📑 Blueprint-Tresor Freigabe</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            <p class="text-xs text-eve-muted mb-4">
                Aktiviere diese Option, um deine Blueprints (Originale und Kopien) und deren Lagerorte mit anderen Mitgliedern der Corporation im "Blueprint-Tresor" zu teilen. 
                Dies hilft der Corp, unnötige Doppelkäufe zu vermeiden und den Austausch von Produktionsmitteln zu vereinfachen.
            </p>

            <form action="{{ path('app_profile_update_blueprint_sharing') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('update_blueprint_sharing') }}">

                <div class="mb-4">
                    <label class="flex items-center cursor-pointer text-xs text-eve-muted select-none">
                        <input type="checkbox" name="share_blueprints" value="1" {% if user.shareBlueprints %}checked{% endif %} class="mr-2 cursor-pointer w-4 h-4 accent-eve-primary">
                        <span>
                            <strong>Meine Blueprints im Corp-Blueprint-Tresor freigeben</strong>
                        </span>
                    </label>
                </div>

                <button type="submit" class="w-full inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm py-2.5 shadow-eve transition-all duration-300 hover:-translate-y-0.5 cursor-pointer mt-4">
                    Freigabe-Einstellungen speichern
                </button>
            </form>
        </div>
    </details>

    <!-- Persönliche Corp-Assets Einstellungen -->
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mt-6 group" id="profile-personal-assets">
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-lg text-white">
            <span>💼 Persönliche Corp-Assets (Hangare & Container)</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            <p class="text-xs text-eve-muted mb-4">
                Hier kannst du Corp-Hangare oder darin liegende Container markieren, damit deren Inhalt zu deinem persönlichen Vermögen und deinen Assets hinzugerechnet wird. 
                Es stehen nur Hangare und Container zur Auswahl, für deren Corporationen du mindestens einen verknüpften Charakter besitzt.
            </p>

            <form action="{{ path('app_profile_personal_assets') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('update_personal_assets') }}">

                <!-- Corp Hangars Section -->
                <h3 class="text-sm font-semibold mb-2 text-white text-gradient">🏢 Corporation Hangare</h3>
                {% if availableHangars is not empty %}
                    <div class="mb-5 max-h-[200px] overflow-y-auto bg-black/20 p-3 rounded-md border border-eve-border">
                        {% for hangar in availableHangars %}
                            {% set isChecked = false %}
                            {% for config in user.personalCorpHangars %}
                                {% if config.corporationId == hangar.corpId and config.locationId == hangar.locationId and config.locationFlag == hangar.locationFlag %}
                                    {% set isChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <div class="mb-2">
                                <label class="flex items-center cursor-pointer text-xs text-eve-muted select-none">
                                    <input type="checkbox" name="hangars[]" value="{{ hangar.id }}" {% if isChecked %}checked{% endif %} class="mr-2 cursor-pointer w-4 h-4 accent-eve-primary">
                                    <span>
                                        <strong>{{ hangar.locationName }}</strong> - <span class="text-eve-primary">{{ hangar.divisionName }}</span>
                                    </span>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-xs text-eve-muted mb-4">Keine verfügbaren Corporation-Hangare gefunden.</p>
                {% endif %}

                <!-- Corp Containers Section -->
                <h3 class="text-sm font-semibold mb-1 text-white text-gradient">📦 Container in Corp-Hangaren</h3>
                <p class="text-xs text-eve-muted mb-3">
                    Hinweis: Container in oben bereits als privat ausgewählten Corp-Hangaren werden automatisch berücksichtigt und müssen nicht zusätzlich ausgewählt werden (eine Doppelauswahl wird vom System automatisch bereinigt).
                </p>
                {% if availableContainers is not empty %}
                    <div class="mb-5 max-h-[200px] overflow-y-auto bg-black/20 p-3 rounded-md border border-eve-border">
                        {% for container in availableContainers %}
                            {% set isChecked = false %}
                            {% for config in user.personalCorpContainers %}
                                {% if config.corporationId == container.corpId and config.itemId == container.itemId %}
                                    {% set isChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <div class="mb-2">
                                <label class="flex items-center cursor-pointer text-xs text-eve-muted select-none">
                                    <input type="checkbox" name="containers[]" value="{{ container.id }}" {% if isChecked %}checked{% endif %} class="mr-2 cursor-pointer w-4 h-4 accent-eve-primary">
                                    <span>
                                        <strong>{{ container.name }}</strong> (in {{ container.locationName }} - <span class="text-sky-400">{{ container.locationFlag }}</span>)
                                    </span>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="text-xs text-eve-muted mb-4">Keine verfügbaren Container in Corporation-Hangaren gefunden.</p>
                {% endif %}

                <button type="submit" class="w-full inline-flex items-center justify-center border border-transparent rounded-lg bg-eve-primary hover:brightness-115 text-[#060911] hover:text-[#060911] font-semibold text-sm py-2.5 shadow-eve transition-all duration-300 hover:-translate-y-0.5 cursor-pointer mt-4">
                    Einstellungen speichern
                </button>
            </form>
        </div>
    </details>

    <!-- Wanderer Exit-Alerts Einstellungen -->
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mt-6 group" id="profile-wanderer-alerts">
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-lg text-white">
            <span>Wanderer Exit-Alerts &amp; Routen</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            <p class="text-xs text-eve-muted mb-6">
                Definiere hier deine persoenlichen Zielsysteme und deinen privaten Discord-Webhook. Sobald ein Mitglied der Corporation im Wurmloch einen Exit kartiert, der deinen Kriterien entspricht, erhaeltst du automatisch eine Direktnachricht auf deinen privaten Discord-Server.
            </p>

            <!-- Personal Webhook Section -->
            <div class="p-4 bg-black/30 border border-eve-border/60 rounded-lg mb-6">
                <h4 class="text-sm font-semibold text-white mb-2">Persoenlicher Discord-Webhook</h4>
                <p class="text-xs text-eve-muted mb-3">Trage hier die Webhook-URL deines privaten Discord-Servers ein.</p>
                <form action="{{ path('app_personal_wanderer_save_webhook') }}" method="POST" class="flex flex-col sm:flex-row gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('personal_wanderer_webhook_save') }}">
                    <input type="url" name="discord_webhook_wanderer" value="{{ personalWebhook }}" placeholder="https://discord.com/api/webhooks/..." class="w-full bg-[#080d1a] border border-eve-border rounded-lg px-3 py-2 text-xs text-white focus:border-eve-primary focus:outline-none">
                    <button type="submit" class="bg-eve-primary text-black font-semibold px-4 py-2 rounded-lg hover:bg-opacity-90 transition-all text-xs whitespace-nowrap cursor-pointer">
                        Speichern
                    </button>
                </form>
                {% if personalWebhook %}
                    <form action="{{ path('app_personal_wanderer_test_webhook') }}" method="POST" class="mt-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('personal_wanderer_test_webhook') }}">
                        <button type="submit" class="border border-eve-border hover:border-eve-primary text-eve-muted hover:text-white px-3 py-1.5 rounded text-xs transition-colors cursor-pointer">
                            Testnachricht an mich senden
                        </button>
                    </form>
                {% endif %}
            </div>

            <!-- Personal Rules Table Section -->
            <h4 class="text-sm font-semibold text-white mb-2">Meine Routenregeln</h4>
            <div class="overflow-x-auto mb-6">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-eve-border text-eve-muted uppercase text-[10px]">
                            <th class="py-2.5 px-3">Status</th>
                            <th class="py-2.5 px-3">Bezeichnung</th>
                            <th class="py-2.5 px-3">Zielsystem</th>
                            <th class="py-2.5 px-3">Max. Spruenge</th>
                            <th class="py-2.5 px-3">Sicherheit</th>
                            <th class="py-2.5 px-3">Cooldown</th>
                            <th class="py-2.5 px-3 text-right">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-eve-border/40">
                        {% for rule in userWandererRules %}
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="py-3 px-3">
                                    {% if rule.isActive %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">Aktiv</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-rose-500/10 text-rose-400 border border-rose-500/30">Inaktiv</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 px-3 font-semibold text-white">{{ rule.name }}</td>
                                <td class="py-3 px-3 text-eve-primary font-mono">{{ rule.targetSolarSystemName }}</td>
                                <td class="py-3 px-3 text-white">{{ rule.maxJumps }} Spruenge</td>
                                <td class="py-3 px-3">
                                    {% if rule.securityMode == 'highsec_only' %}
                                        <span class="text-emerald-400">Nur Highsec</span>
                                    {% elseif rule.securityMode == 'highsec_lowsec' %}
                                        <span class="text-amber-400">Highsec &amp; Lowsec</span>
                                    {% else %}
                                        <span class="text-rose-400">Alle (inkl. Null)</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 px-3 text-eve-muted">{{ rule.cooldownMinutes }} Min.</td>
                                <td class="py-3 px-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <form action="{{ path('app_personal_wanderer_toggle_rule', {id: rule.id}) }}" method="POST" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('personal_wanderer_rule_toggle_' ~ rule.id) }}">
                                            <button type="submit" class="text-xs text-eve-muted hover:text-white px-2 py-1 rounded bg-black/40 border border-eve-border cursor-pointer">
                                                {{ rule.isActive ? 'Deaktivieren' : 'Aktivieren' }}
                                            </button>
                                        </form>
                                        <form action="{{ path('app_personal_wanderer_delete_rule', {id: rule.id}) }}" method="POST" class="inline" onsubmit="return confirm('Regel wirklich loeschen?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('personal_wanderer_rule_delete_' ~ rule.id) }}">
                                            <button type="submit" class="text-xs text-rose-400 hover:text-rose-300 px-2 py-1 rounded bg-rose-500/10 border border-rose-500/30 cursor-pointer">
                                                Loeschen
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="py-4 text-center text-eve-muted">
                                    Noch keine persoenlichen Routenregeln angelegt.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Create Rule Form -->
            <div class="p-4 bg-black/30 border border-eve-border/60 rounded-lg">
                <h4 class="text-xs font-semibold text-white mb-3">Neue persoenliche Regel hinzufuegen</h4>
                <form action="{{ path('app_personal_wanderer_create_rule') }}" method="POST">
                    <input type="hidden" name="_token" value="{{ csrf_token('personal_wanderer_rule_create') }}">

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-4">
                        <div>
                            <label for="rule_name" class="block text-xs text-eve-muted mb-1">Bezeichnung</label>
                            <input type="text" id="rule_name" name="name" placeholder="z. B. Jita Shopping Exit" required class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                        </div>

                        <div>
                            <label for="rule_target_system" class="block text-xs text-eve-muted mb-1">Zielsystem (Name oder ID)</label>
                            <input type="text" id="rule_target_system" name="target_system" value="Jita" required class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                        </div>

                        <div>
                            <label for="rule_max_jumps" class="block text-xs text-eve-muted mb-1">Max. Spruenge</label>
                            <input type="number" id="rule_max_jumps" name="max_jumps" value="10" min="1" max="50" required class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                        </div>

                        <div>
                            <label for="rule_security_mode" class="block text-xs text-eve-muted mb-1">Erlaubte Sicherheit</label>
                            <select id="rule_security_mode" name="security_mode" class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                                <option value="highsec_only" selected>Nur Highsec (&ge; 0.45)</option>
                                <option value="highsec_lowsec">Highsec &amp; Lowsec (&ge; 0.0)</option>
                                <option value="any">Alle Routen (inkl. Nullsec)</option>
                            </select>
                        </div>

                        <div>
                            <label for="rule_cooldown_minutes" class="block text-xs text-eve-muted mb-1">Cooldown (Minuten)</label>
                            <input type="number" id="rule_cooldown_minutes" name="cooldown_minutes" value="180" min="0" max="1440" required class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                        </div>
                    </div>

                    <button type="submit" class="bg-eve-primary text-black font-semibold py-2 px-5 rounded hover:bg-opacity-90 transition-all text-xs cursor-pointer">
                        Persoenliche Regel erstellen
                    </button>
                </form>
            </div>
        </div>
    </details>

    <!-- Custom Tracking Lists Box -->
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mt-6 group" id="tracking-manager">
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-lg text-white">
            <span>📋 Custom Tracking-Listen</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            <p class="text-sm text-eve-muted mt-1 mb-4">Erstelle persönliche Listen, verwalte Gegenstände oder kopiere System-Vorlagen. Die Einnahmen-Auswertung findest du unter "Persönlich -> Asset-Tracking".</p>
            
            {# React Island mount point #}
            <div data-react-component="TrackingListManager" data-react-props="{{ {'jwtToken': jwt_token(app.user)}|json_encode|e('html_attr') }}"></div>
        </div>
    </details>
</div>
{% endblock %}
