{% extends 'base.html.twig' %}

{% block title %}Mein Profil{% endblock %}

{% block body %}
<div class="container container-narrow mt-5 mb-6">
    <!-- Headline -->
    <h1 class="title is-2 text-gradient">
        Mein Profil
    </h1>

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="notification is-success">
            ✔️ {{ message }}
        </div>
    {% endfor %}

    <!-- Profile Details Box -->
    <details class="box mt-5" id="profile-details" {% if errors is not empty %}open{% endif %}>
        <summary>👤 User-Profil</summary>
        <div class="details-content">
            <div class="form-group">
                <label>Username</label>
                <span class="is-size-6 has-text-grey-light">{{ user.username }}</span>
            </div>

            {% if not is_granted('ROLE_MEMBER') %}
                <div class="form-group mt-4">
                    <label>Zugriffsstatus</label>
                    <div class="notification is-warning mb-0">
                        Dein Account ist noch nicht freigeschaltet. Bitte wende dich an einen Corp-Officer oder Administrator, um verifiziert zu werden.
                    </div>
                </div>
            {% endif %}

            <!-- Password Change Form Box -->
            <details class="profile-details-wrapper mt-4" id="profile-password-edit" {% if errors is not empty %}open{% endif %}>
                <summary class="profile-details-summary">🔑 Passwort ändern</summary>
                <div class="mt-3">
                    <!-- Errors -->
                    {% if errors is not empty %}
                        <div class="notification is-danger mt-3">
                            <ul>
                                {% for error in errors %}
                                    <li>❌ {{ error }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <form action="{{ path('app_profile') }}" method="POST" class="mt-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                        <!-- Current Password -->
                        <div class="form-group">
                            <label for="current_password">Aktuelles Passwort</label>
                            <input type="password" id="current_password" name="current_password" required placeholder="Dein aktuelles Passwort...">
                            <p class="has-text-grey-light is-size-7 mt-1">Wird zur Verifizierung benötigt (auch bei temporären Passwörtern).</p>
                        </div>

                        <!-- New Password -->
                        <div class="form-group mt-4">
                            <label for="new_password">Neues Passwort</label>
                            <input type="password" id="new_password" name="new_password" required placeholder="Mindestens 6 Zeichen...">
                        </div>

                        <!-- New Password Confirm -->
                        <div class="form-group mt-4">
                            <label for="new_password_confirm">Neues Passwort wiederholen</label>
                            <input type="password" id="new_password_confirm" name="new_password_confirm" required placeholder="Neues Passwort bestätigen...">
                        </div>

                        <!-- Submit button -->
                        <button type="submit" class="button is-primary is-fullwidth mt-5">
                            Passwort aktualisieren
                        </button>
                    </form>
                </div>
            </details>
        </div>
    </details>

    <!-- Blueprint-Tresor Freigabe-Einstellungen -->
    <details class="box mt-5" id="profile-blueprint-sharing">
        <summary>📑 Blueprint-Tresor Freigabe</summary>
        <div class="details-content">
            <p class="is-size-7 has-text-grey-light mb-4">
                Aktiviere diese Option, um deine Blueprints (Originale und Kopien) und deren Lagerorte mit anderen Mitgliedern der Corporation im "Blueprint-Tresor" zu teilen. 
                Dies hilft der Corp, unnötige Doppelkäufe zu vermeiden und den Austausch von Produktionsmitteln zu vereinfachen.
            </p>

            <form action="{{ path('app_profile_update_blueprint_sharing') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('update_blueprint_sharing') }}">

                <div class="control mb-4">
                    <label class="checkbox has-text-grey-light" style="display: flex; align-items: center; cursor: pointer;">
                        <input type="checkbox" name="share_blueprints" value="1" {% if user.shareBlueprints %}checked{% endif %} class="mr-2" style="cursor: pointer;">
                        <span>
                            <strong>Meine Blueprints im Corp-Blueprint-Tresor freigeben</strong>
                        </span>
                    </label>
                </div>

                <button type="submit" class="button is-primary is-fullwidth mt-4">
                    Freigabe-Einstellungen speichern
                </button>
            </form>
        </div>
    </details>

    <!-- Persönliche Corp-Assets Einstellungen -->
    <details class="box mt-5" id="profile-personal-assets">
        <summary>💼 Persönliche Corp-Assets (Hangare & Container)</summary>
        <div class="details-content">
            <p class="is-size-7 has-text-grey-light mb-4">
                Hier kannst du Corp-Hangare oder darin liegende Container markieren, damit deren Inhalt zu deinem persönlichen Vermögen und deinen Assets hinzugerechnet wird. 
                Es stehen nur Hangare und Container zur Auswahl, für deren Corporationen du mindestens einen verknüpften Charakter besitzt.
            </p>

            <form action="{{ path('app_profile_personal_assets') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('update_personal_assets') }}">

                <!-- Corp Hangars Section -->
                <h3 class="title is-6 mb-2 text-gradient">🏢 Corporation Hangare</h3>
                {% if availableHangars is not empty %}
                    <div class="field mb-5" style="max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; border: 1px solid var(--theme-card-border);">
                        {% for hangar in availableHangars %}
                            {% set isChecked = false %}
                            {% for config in user.personalCorpHangars %}
                                {% if config.corporationId == hangar.corpId and config.locationId == hangar.locationId and config.locationFlag == hangar.locationFlag %}
                                    {% set isChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <div class="control mb-2">
                                <label class="checkbox has-text-grey-light" style="display: flex; align-items: center; cursor: pointer;">
                                    <input type="checkbox" name="hangars[]" value="{{ hangar.id }}" {% if isChecked %}checked{% endif %} class="mr-2" style="cursor: pointer;">
                                    <span>
                                        <strong>{{ hangar.locationName }}</strong> - <span class="has-text-info">{{ hangar.divisionName }}</span>
                                    </span>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="is-size-7 has-text-grey mb-4">Keine verfügbaren Corporation-Hangare gefunden.</p>
                {% endif %}

                <!-- Corp Containers Section -->
                <h3 class="title is-6 mb-2 text-gradient">📦 Container in Corp-Hangaren</h3>
                {% if availableContainers is not empty %}
                    <div class="field mb-5" style="max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.2); padding: 12px; border-radius: 6px; border: 1px solid var(--theme-card-border);">
                        {% for container in availableContainers %}
                            {% set isChecked = false %}
                            {% for config in user.personalCorpContainers %}
                                {% if config.corporationId == container.corpId and config.itemId == container.itemId %}
                                    {% set isChecked = true %}
                                {% endif %}
                            {% endfor %}
                            <div class="control mb-2">
                                <label class="checkbox has-text-grey-light" style="display: flex; align-items: center; cursor: pointer;">
                                    <input type="checkbox" name="containers[]" value="{{ container.id }}" {% if isChecked %}checked{% endif %} class="mr-2" style="cursor: pointer;">
                                    <span>
                                        <strong>{{ container.name }}</strong> (in {{ container.locationName }} - <span class="has-text-info">{{ container.locationFlag }}</span>)
                                    </span>
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="is-size-7 has-text-grey mb-4">Keine verfügbaren Container in Corporation-Hangaren gefunden.</p>
                {% endif %}

                <button type="submit" class="button is-primary is-fullwidth mt-4">
                    Einstellungen speichern
                </button>
            </form>
        </div>
    </details>



    <!-- Custom Tracking Lists Box -->
    <details class="box mt-5" id="tracking-manager">
        <summary>📋 Custom Tracking-Listen</summary>
        <div class="details-content">
            <p class="subtitle is-6 has-text-grey-light mt-1">Erstelle persönliche Listen, verwalte Gegenstände oder kopiere System-Vorlagen. Die Einnahmen-Auswertung findest du unter "Persönlich -> Asset-Tracking".</p>
            
            {# React Island mount point #}
            <div data-react-component="TrackingListManager" data-react-props="{{ {'jwtToken': jwt_token(app.user)}|json_encode|e('html_attr') }}"></div>
        </div>
    </details>

</div>
{% endblock %}
