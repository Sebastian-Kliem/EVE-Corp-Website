{% extends 'base.html.twig' %}

{% block title %}Planetary Interaction (PI) Übersicht{% endblock %}

{% block body %}
{% set reactProps = {
    charactersList: charactersList,
    apiDataUrl: path('app_profile_pi_data'),
    imagePaths: {
        types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
        characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
    }
} %}

<div data-react-component="PIOverview" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
{% endblock %}
