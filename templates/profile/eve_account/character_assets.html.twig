{% extends 'base.html.twig' %}

{% block title %}Inventar von {{ character.name }}{% endblock %}

{% block body %}
{% set characterProps = {
    id: character.id,
    name: character.name,
    lastAssetsUpdate: character.lastAssetsUpdate ? character.lastAssetsUpdate|date('d.m.Y H:i:s') : null
} %}

{% set reactProps = {
    character: characterProps,
    groupedAssets: groupedAssets,
    imagePaths: {
        types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
        characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
    },
    backUrl: path('app_profile')
} %}

<div data-react-component="CharacterAssets" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
{% endblock %}
