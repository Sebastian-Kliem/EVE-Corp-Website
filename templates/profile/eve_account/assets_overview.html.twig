{% extends 'base.html.twig' %}

{% block title %}Gesamt-Inventar & Wallet{% endblock %}

{% block body %}
{% set characterDataProps = [] %}
{% for data in characterData %}
    {% set characterProps = {
        id: data.character.id,
        name: data.character.name,
        lastAssetsUpdate: data.character.lastAssetsUpdate ? data.character.lastAssetsUpdate|date('d.m.Y H:i') : null
    } %}
    {% set characterDataProps = characterDataProps|merge([{
        character: characterProps,
        walletBalance: data.walletBalance,
        locations: data.locations
    }]) %}
{% endfor %}

{% set reactProps = {
    totalWallet: totalWallet,
    characterData: characterDataProps,
    imagePaths: {
        types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
        characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
    },
    profileUrl: path('app_profile'),
    jwtToken: jwt_token(app.user)
} %}

<div data-react-component="AssetsOverview" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
{% endblock %}
