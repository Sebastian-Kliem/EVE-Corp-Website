{% extends 'base.html.twig' %}

{% block title %}Gesamt-Inventar & Wallet{% endblock %}

{% block body %}
<style>
details summary {
    list-style: none; /* Modern standard to hide default arrow */
}
details summary::-webkit-details-marker {
    display: none; /* Safari and older Chrome to hide default arrow */
}
details summary::marker {
    display: none; /* Firefox to hide default arrow */
}
details[open] .details-arrow {
    transform: rotate(180deg);
}
</style>

<div class="w-full max-w-[1200px] mx-auto px-6 mt-10 mb-12">
    {# Header & Combined Wallet Balance #}
    <div class="p-6 mb-6 rounded-lg border border-eve-border backdrop-blur-md shadow-eve assets-header-gradient relative overflow-hidden">
        <div class="assets-header-bg-text">ISK</div>
        <div class="flex flex-wrap items-center gap-4">
            <div class="flex-1 min-w-[280px]">
                <span class="text-eve-muted text-sm uppercase tracking-wider">
                    GESAMTVERMÖGEN (Wallet + Assets)
                </span>
                <h1 class="text-3xl font-extrabold mt-1 mb-3 text-[#00ffaa] font-mono">
                    {{ netWorth|number_format(2, ',', '.') }} <span class="text-xl">ISK</span>
                </h1>
                <div class="flex gap-8 flex-wrap border-t border-white/8 pt-3">
                    <div>
                        <span class="text-eve-muted text-xs uppercase tracking-wider">Wallet</span>
                        <p class="font-semibold text-base text-white">
                            {{ totalWallet|number_format(2, ',', '.') }} ISK
                        </p>
                    </div>
                    <div>
                        <span class="text-eve-muted text-xs uppercase tracking-wider">Assets</span>
                        <p class="font-semibold text-base text-eve-primary">
                            {{ totalAssetVal|number_format(2, ',', '.') }} ISK
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# CARD 0: ERTRAGSJOURNAL (PERFORMANCE) #}
    {% set perfProps = {
        charactersList: charactersList,
        apiDataUrl: path('app_dashboard_performance_data'),
        omegaAccountCount: omegaAccountCount,
        imagePaths: {
            types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
            characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
        }
    } %}

    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mb-4 group" open>
        <summary class="p-4 font-semibold cursor-pointer list-none flex justify-between items-center select-none bg-black/10">
            <h3 class="text-sm font-semibold mb-0 text-eve-primary flex items-center gap-2">
                📊 Ertragsjournal (Performance)
            </h3>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-5 border-t border-eve-border bg-[#0a0f1d]/30">
            <div data-react-component="PerformanceLedger" data-react-props="{{ perfProps|json_encode|e('html_attr') }}"></div>
        </div>
    </details>

    {# CARD 1: GESAMT-INVENTAR (ASSETS) #}
    {% set characterDataProps = [] %}
    {% for data in characterData %}
        {% set characterProps = {
            id: data.character.id,
            name: data.character.name,
            lastAssetsUpdate: data.character.lastAssetsUpdate ? data.character.lastAssetsUpdate|date('d.m.Y H:i') : null,
            tags: data.character.tags
        } %}
        {% set characterDataProps = characterDataProps|merge([{
            character: characterProps,
            walletBalance: data.walletBalance,
            locations: data.locations
        }]) %}
    {% endfor %}

    {% set assetsProps = {
        totalWallet: totalWallet,
        characterData: characterDataProps,
        imagePaths: {
            types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
            characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
        },
        profileUrl: path('app_profile'),
        jwtToken: jwt_token(app.user)
    } %}

    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mb-4 group">
        <summary class="p-4 font-semibold cursor-pointer list-none flex justify-between items-center select-none bg-black/10">
            <h3 class="text-sm font-semibold mb-0 text-eve-primary flex items-center gap-2">
                🎒 Gesamt-Inventar (Assets)
            </h3>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-5 border-t border-eve-border bg-[#0a0f1d]/30">
            <div data-react-component="AssetsOverview" data-react-props="{{ assetsProps|json_encode|e('html_attr') }}"></div>
        </div>
    </details>

    {# CARD 2: VERMÖGENSVERLAUF (HISTORY) #}
    {% set historyProps = {
        characters: charactersData,
        snapshots: snapshotsData,
        currentValues: currentValues,
        omegaAccountCount: omegaAccountCount
    } %}

    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mb-4 group">
        <summary class="p-4 font-semibold cursor-pointer list-none flex justify-between items-center select-none bg-black/10">
            <h3 class="text-sm font-semibold mb-0 text-eve-primary flex items-center gap-2">
                📈 Vermögensverlauf (History)
            </h3>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-5 border-t border-eve-border bg-[#0a0f1d]/30">
            <div data-react-component="ValueHistory" data-react-props="{{ historyProps|json_encode|e('html_attr') }}"></div>
        </div>
    </details>

    {# CARD 3: PERSÖNLICHES WALLET (JOURNAL) #}
    {% set walletProps = {
        journalEntries: journalEntriesData,
        characters: charactersData
    } %}

    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden mb-4 group">
        <summary class="p-4 font-semibold cursor-pointer list-none flex justify-between items-center select-none bg-black/10">
            <h3 class="text-sm font-semibold mb-0 text-eve-primary flex items-center gap-2">
                💳 Persönliches Wallet (Journal)
            </h3>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-5 border-t border-eve-border bg-[#0a0f1d]/30">
            <div data-react-component="WalletJournal" data-react-props="{{ walletProps|json_encode|e('html_attr') }}"></div>
        </div>
    </details>

</div>
{% endblock %}
