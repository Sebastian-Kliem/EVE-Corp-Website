{% extends 'base.html.twig' %}

{% block title %}Vermögensverlauf{% endblock %}

{% block body %}
<div class="w-full px-6 mt-8 mb-12">
    {% set reactProps = {
        characters: charactersData,
        snapshots: snapshotsData,
        currentValues: currentValues,
        omegaAccountCount: omegaAccountCount
    } %}
    <div data-react-component="ValueHistory" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
