{% extends 'base.html.twig' %}

{% import '_macros/secret_field.html.twig' as secret_field %}

{% block title %}Wanderer-Integration & Routen{% endblock %}

{% block body %}
<div class="w-full px-6 mt-10 mb-12">
    <!-- Headline -->
    <div class="flex justify-between items-center flex-wrap gap-4 mb-6">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-semibold text-white text-gradient">
                Wanderer Integration & Exit-Routen
            </h1>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_admin_discord_index') }}" class="inline-flex items-center justify-center border border-eve-border hover:border-eve-primary text-eve-text hover:text-eve-primary bg-transparent rounded-lg px-4 py-2 font-medium transition-all duration-300 cursor-pointer">
                Discord-Uebersicht
            </a>
            <a href="{{ path('app_profile') }}" class="inline-flex items-center justify-center border border-eve-border hover:border-eve-primary text-eve-text hover:text-eve-primary bg-transparent rounded-lg px-4 py-2 font-medium transition-all duration-300 cursor-pointer">
                Zurueck zum Profil
            </a>
        </div>
    </div>


    <!-- Wanderer Connection Info Card -->
    <div class="py-5 px-6 rounded-lg bg-black/20 border border-eve-border mb-8">
        <div class="text-sm leading-relaxed text-eve-text">
            <strong class="text-white">Anbindung an Wanderer:</strong>
            <p class="text-xs text-eve-muted mt-1">
                Mit Wanderer-URL, Map-Slug und Map-API-Key fragt die Toolbox jede Minute die Verbindungen der Map ab und prüft neue Verbindungen gegen die Routenregeln (Cron-Job <code>wanderer:sync-connections</code>).
            </p>
            <p class="text-xs text-eve-muted mt-2">
                Eine neue Verbindung wird nur gemeldet, wenn das System vorher nicht schon über eine andere Verbindung auf der Map erreichbar war.
            </p>
        </div>
    </div>

    <!-- Configuration Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Settings Form (Left) -->
        <div class="bg-eve-card border border-eve-border shadow-eve p-6 rounded-lg lg:col-span-1">
            <h3 class="text-lg font-semibold mb-2 text-white">
                Integrationseinstellungen
            </h3>
            <p class="text-xs text-eve-muted mb-6">Discord-Kanal für Corp-Benachrichtigungen und Zugang zur Wanderer-Map.</p>

            <form action="{{ path('app_admin_wanderer_save_settings') }}" method="POST" data-controller="wanderer-connection-test" data-wanderer-connection-test-endpoint-value="{{ path('app_admin_wanderer_test_connection') }}" data-wanderer-connection-test-token-value="{{ csrf_token('wanderer_connection_test') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('wanderer_settings_save') }}">

                <div class="space-y-5">
                    <div>
                        <label for="discord_webhook_wanderer" class="block text-xs font-medium text-white">
                            Discord Webhook URL (Wanderer-Kanal)
                        </label>
                        <p class="text-[11px] text-eve-muted mt-0.5 mb-1.5">Eigener Discord-Kanal ausschließlich für K-Space- und Exit-Meldungen.</p>
                        {{ secret_field.input('discord_webhook_wanderer', settings.discord_webhook_wanderer, 'https://discord.com/api/webhooks/...', 'w-full bg-[#080d1a] border border-eve-border rounded-lg px-3 py-2 text-xs text-white focus:border-eve-primary focus:outline-none transition-colors') }}
                        {{ secret_field.remove_checkbox('discord_webhook_wanderer', settings.discord_webhook_wanderer) }}
                    </div>

                    <div>
                        <label for="discord_ping_role_wanderer" class="block text-xs font-medium text-white">
                            Ping-Rolle (optional)
                        </label>
                        <p class="text-[11px] text-eve-muted mt-0.5 mb-1.5">Rolle, die bei Corp-Meldungen erwähnt wird (Rollen-ID oder @here).</p>
                        <input type="text" id="discord_ping_role_wanderer" name="discord_ping_role_wanderer" value="{{ settings.discord_ping_role_wanderer }}" placeholder="z. B. 123456789012345678 oder @here" class="w-full bg-[#080d1a] border border-eve-border rounded-lg px-3 py-2 text-xs text-white focus:border-eve-primary focus:outline-none transition-colors">
                    </div>

                    <div>
                        <label for="wanderer_api_url" class="block text-xs font-medium text-white">
                            Wanderer-URL
                        </label>
                        <p class="text-[11px] text-eve-muted mt-0.5 mb-1.5">Basis-URL der Wanderer-Instanz.</p>
                        <input type="url" id="wanderer_api_url" name="wanderer_api_url" data-wanderer-connection-test-target="url" value="{{ settings.wanderer_api_url }}" placeholder="https://wanderer.keepers-of-duat.de" class="w-full bg-[#080d1a] border border-eve-border rounded-lg px-3 py-2 text-xs text-white focus:border-eve-primary focus:outline-none transition-colors">
                    </div>

                    <div>
                        <label for="wanderer_map_slug" class="block text-xs font-medium text-white">
                            Map-Slug
                        </label>
                        <p class="text-[11px] text-eve-muted mt-0.5 mb-1.5">Kurzname der Map aus der Wanderer-URL.</p>
                        <input type="text" id="wanderer_map_slug" name="wanderer_map_slug" data-wanderer-connection-test-target="slug" value="{{ settings.wanderer_map_slug }}" placeholder="keepers-of-duat" class="w-full bg-[#080d1a] border border-eve-border rounded-lg px-3 py-2 text-xs text-white focus:border-eve-primary focus:outline-none transition-colors">
                    </div>

                    <div>
                        <label for="wanderer_api_key" class="block text-xs font-medium text-white">
                            Map-API-Key
                        </label>
                        <p class="text-[11px] text-eve-muted mt-0.5 mb-1.5">Die Toolbox fragt damit jede Minute neue Verbindungen ab und prüft die Routenregeln.</p>
                        {{ secret_field.input('wanderer_api_key', settings.wanderer_api_key, 'API-Key aus den Map-Einstellungen', 'w-full bg-[#080d1a] border border-eve-border rounded-lg px-3 py-2 text-xs text-white focus:border-eve-primary focus:outline-none transition-colors', 'key') }}
                        {{ secret_field.remove_checkbox('wanderer_api_key', settings.wanderer_api_key) }}
                        <button type="button" data-wanderer-connection-test-target="button" data-action="wanderer-connection-test#test" class="mt-2 w-full border border-eve-border hover:border-eve-primary text-eve-text hover:text-white py-1.5 px-4 rounded-lg transition-all text-xs cursor-pointer disabled:opacity-50 disabled:cursor-wait">
                            Verbindung testen
                        </button>
                        <p data-wanderer-connection-test-target="result" class="hidden"></p>
                    </div>

                    <div class="pt-2 flex flex-col gap-2">
                        <button type="submit" class="w-full bg-eve-primary text-black font-semibold py-2 px-4 rounded-lg hover:bg-opacity-90 transition-all text-xs cursor-pointer">
                            Einstellungen speichern
                        </button>
                    </div>
                </div>
            </form>

            <hr class="border-eve-border my-6">

            <!-- Test Webhook Form -->
            <form action="{{ path('app_admin_wanderer_test_discord') }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('wanderer_test_discord') }}">
                <button type="submit" class="w-full border border-eve-border hover:border-eve-primary text-eve-text hover:text-white py-2 px-4 rounded-lg transition-all text-xs cursor-pointer">
                    Testnachricht senden
                </button>
            </form>
        </div>

        <!-- Corporate Route Rules (Right) -->
        <div class="bg-eve-card border border-eve-border shadow-eve p-6 rounded-lg lg:col-span-2">
            <h3 class="text-lg font-semibold mb-2 text-white">
                Aktive Corp-Routenregeln
            </h3>
            <p class="text-xs text-eve-muted mb-6">Wann soll eine Benachrichtigung an den Corp-Kanal ausgeloest werden?</p>

            <!-- Rules Table -->
            <div class="overflow-x-auto mb-6">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-eve-border text-eve-muted uppercase text-[10px]">
                            <th class="py-2.5 px-3">Status</th>
                            <th class="py-2.5 px-3">Regel-Name</th>
                            <th class="py-2.5 px-3">Zielsystem</th>
                            <th class="py-2.5 px-3">Max. Spruenge</th>
                            <th class="py-2.5 px-3">Sicherheitsmodus</th>
                            <th class="py-2.5 px-3">Zuletzt gemeldet</th>
                            <th class="py-2.5 px-3 text-right">Aktionen</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-eve-border/40">
                        {% for rule in corpRules %}
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="py-3 px-3">
                                    {% if rule.isActive %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">Aktiv</span>
                                    {% else %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-rose-500/10 text-rose-400 border border-rose-500/30">Inaktiv</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 px-3 font-semibold text-white">{{ rule.name }}</td>
                                <td class="py-3 px-3 text-eve-primary font-mono">{{ rule.targetSolarSystemName }}</td>
                                <td class="py-3 px-3 text-white">{{ rule.maxJumps }} Spruenge</td>
                                <td class="py-3 px-3">
                                    {% if rule.securityMode == 'highsec_only' %}
                                        <span class="text-emerald-400">Nur Highsec</span>
                                    {% elseif rule.securityMode == 'highsec_lowsec' %}
                                        <span class="text-amber-400">Highsec & Lowsec</span>
                                    {% else %}
                                        <span class="text-rose-400">Alle (inkl. Null)</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 px-3 text-eve-muted">{{ rule.lastTriggeredAt ? rule.lastTriggeredAt|date('d.m.Y H:i') : '-' }}</td>
                                <td class="py-3 px-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <form action="{{ path('app_admin_wanderer_toggle_rule', {id: rule.id}) }}" method="POST" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('wanderer_rule_toggle_' ~ rule.id) }}">
                                            <button type="submit" class="text-xs text-eve-muted hover:text-white px-2 py-1 rounded bg-black/40 border border-eve-border cursor-pointer">
                                                {{ rule.isActive ? 'Deaktivieren' : 'Aktivieren' }}
                                            </button>
                                        </form>
                                        <form action="{{ path('app_admin_wanderer_delete_rule', {id: rule.id}) }}" method="POST" class="inline" onsubmit="return confirm('Regel wirklich loeschen?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('wanderer_rule_delete_' ~ rule.id) }}">
                                            <button type="submit" class="text-xs text-rose-400 hover:text-rose-300 px-2 py-1 rounded bg-rose-500/10 border border-rose-500/30 cursor-pointer">
                                                Loeschen
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="py-6 text-center text-eve-muted">
                                    Noch keine Corp-Routenregeln angelegt. Erstelle unten die erste Regel (z. B. Jita Highsec).
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <!-- Add Rule Form -->
            <div class="p-4 bg-black/30 border border-eve-border/60 rounded-lg">
                <h4 class="text-sm font-semibold text-white mb-3">Neue Corp-Routenregel hinzufuegen</h4>
                <form action="{{ path('app_admin_wanderer_create_rule') }}" method="POST" data-controller="solar-system-autocomplete" data-solar-system-autocomplete-url-value="{{ path('app_solar_system_search') }}" data-action="submit->solar-system-autocomplete#validate">
                    <input type="hidden" name="_token" value="{{ csrf_token('wanderer_rule_create') }}">

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
                        <div>
                            <label for="name" class="block text-xs text-eve-muted mb-1">Bezeichnung</label>
                            <input type="text" id="name" name="name" placeholder="z. B. Jita Highsec Express" required class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                        </div>

                        <div>
                            <label for="target_system" class="block text-xs text-eve-muted mb-1">Zielsystem</label>
                            <input type="text" id="target_system" name="target_system" value="Jita" required autocomplete="off" placeholder="Systemname tippen, z. B. Jita" data-solar-system-autocomplete-target="input" data-action="input->solar-system-autocomplete#search keydown->solar-system-autocomplete#navigate blur->solar-system-autocomplete#hideResults" class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                            <input type="hidden" name="target_system_id" value="30000142" data-solar-system-autocomplete-target="systemId">
                            <div data-solar-system-autocomplete-target="results" class="hidden mt-1 max-h-60 overflow-y-auto bg-[#080d1a] border border-eve-border rounded"></div>
                            <p data-solar-system-autocomplete-target="hint" class="hidden text-[11px] text-rose-400 mt-1">Bitte ein System aus der Liste auswählen.</p>
                        </div>

                        <div>
                            <label for="max_jumps" class="block text-xs text-eve-muted mb-1">Max. Spruenge</label>
                            <input type="number" id="max_jumps" name="max_jumps" value="10" min="1" max="50" required class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                        </div>

                        <div>
                            <label for="security_mode" class="block text-xs text-eve-muted mb-1">Erlaubte Sicherheit</label>
                            <select id="security_mode" name="security_mode" class="w-full bg-[#080d1a] border border-eve-border rounded px-3 py-1.5 text-xs text-white focus:border-eve-primary focus:outline-none">
                                <option value="highsec_only" selected>Nur Highsec</option>
                                <option value="highsec_lowsec">Highsec &amp; Lowsec</option>
                                <option value="any">Alle Routen (inkl. Nullsec)</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="bg-eve-primary text-black font-semibold py-2 px-5 rounded hover:bg-opacity-90 transition-all text-xs cursor-pointer">
                        Regel erstellen
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
