{% extends 'base.html.twig' %}

{% block title %}Benutzerverwaltung{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6" data-controller="user-search">
    <!-- Headline -->
    <div class="level">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                Benutzerverwaltung
            </h1>
        </div>
        <div class="level-right">
            <!-- Search bar -->
            <form action="{{ path('app_admin_users') }}" method="GET" class="search-form {% if search is not empty %}is-active{% endif %}">
                <div class="search-wrapper">
                    <input class="input search-input" type="text" name="search" placeholder="Benutzer suchen..." value="{{ search }}" data-user-search-target="input" data-action="input->user-search#filter">
                    <button type="button" class="button search-toggle-btn" onclick="let f=this.closest('.search-form'); let i=f.querySelector('.search-input'); if(f.classList.contains('is-active') && i.value.trim()!==''){f.submit();}else{f.classList.toggle('is-active'); if(f.classList.contains('is-active')){i.focus();}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                    <button type="submit" class="button is-primary search-submit-btn">
                        Suchen
                    </button>
                    {% if search is not empty %}
                        <a href="{{ path('app_admin_users') }}" class="button search-clear-btn" title="Suche zurücksetzen">✕</a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% if label == 'success_temp_password' %}
                <div class="notification is-success is-highlighted mt-4 mb-4">
                    <p class="title is-5 has-text-success">🔑 Temporäres Passwort generiert!</p>
                    <p class="mt-2">Das Passwort für <strong>{{ message.displayName }}</strong> ({{ message.username }}) wurde erfolgreich zurückgesetzt.</p>
                    <div class="box mt-3 mb-2 p-3 has-text-centered box-dashed-success">
                        <span class="is-size-4 has-text-weight-bold monospace-code has-text-primary">{{ message.password }}</span>
                    </div>
                    <p class="is-size-7 has-text-warning">⚠️ WICHTIG: Dieses Passwort wird nur dieses eine Mal angezeigt. Bitte kopiere es jetzt und teile es dem Benutzer vertraulich (z. B. per Discord-DM) mit!</p>
                </div>
            {% else %}
                <div class="notification is-{{ label == 'error' ? 'danger' : 'success' }} mt-4 mb-4">
                    {{ message }}
                </div>
            {% endif %}
        {% endfor %}
    {% endfor %}

    <!-- User Table inside a Glassmorphism box -->
    <div class="box p-0 mt-5 overflow-x-auto">
        <table class="table is-fullwidth is-striped mb-0">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Status / Rollen</th>
                    <th class="has-text-right pr-4">Aktionen zur Rollenänderung</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr data-user-search-target="row" data-username="{{ user.username }}">
                        <td>
                            <span class="has-text-grey-light">{{ user.username }}</span>
                        </td>

                        <!-- Roles Tags -->
                        <td>
                            <div class="tags">
                                {% for role in user.roles %}
                                    {% if role == 'ROLE_RECRUIT' %}
                                        <span class="tag is-warning">Rekrut</span>
                                    {% elseif role == 'ROLE_MEMBER' %}
                                        <span class="tag is-success">Mitglied</span>
                                    {% elseif role == 'ROLE_OFFICER' %}
                                        <span class="tag is-info">Officer</span>
                                    {% elseif role == 'ROLE_CEO' %}
                                        <span class="tag is-primary">CEO</span>
                                    {% elseif role == 'ROLE_ADMIN' %}
                                        <span class="tag is-danger">Administrator</span>
                                    {% else %}
                                        <span class="tag is-dark">{{ role }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </td>

                        <!-- Actions Buttons -->
                        <td class="has-text-right pr-4">

                            {% if user.id != app.user.id %}
                                <div class="buttons is-right">
                                    {% set is_user_ceo = is_granted('ROLE_CEO') %}
                                    {% set can_reset_password = is_user_ceo or (not ('ROLE_ADMIN' in user.roles or 'ROLE_CEO' in user.roles or 'ROLE_OFFICER' in user.roles)) %}

                                    <!-- Passwort zurücksetzen -->
                                    {% if can_reset_password %}
                                        <form action="{{ path('app_admin_reset_password', {'id': user.id}) }}" method="POST" onsubmit="return confirm('Möchtest du das Passwort für {{ user.displayName }} wirklich zurücksetzen? Der Benutzer kann sich danach nur noch mit einem neuen temporären Passwort einloggen.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reset_password_' ~ user.id) }}">
                                            <button type="submit" class="button is-small is-light" title="Passwort zurücksetzen">
                                                🔑 Reset
                                            </button>
                                        </form>
                                     {% endif %}

                                     <!-- Rolle ändern Dropdown -->
                                     {% set target_has_admin = 'ROLE_ADMIN' in user.roles %}
                                     {% set target_has_privileged = 'ROLE_CEO' in user.roles or 'ROLE_OFFICER' in user.roles %}
                                     {% set can_change_role = not target_has_admin and (is_user_ceo or not target_has_privileged) %}

                                     {% if can_change_role %}
                                         {% set current_role = 'ROLE_RECRUIT' %}
                                         {% if 'ROLE_MEMBER' in user.roles %}
                                             {% set current_role = 'ROLE_MEMBER' %}
                                         {% elseif 'ROLE_OFFICER' in user.roles %}
                                             {% set current_role = 'ROLE_OFFICER' %}
                                         {% elseif 'ROLE_CEO' in user.roles %}
                                             {% set current_role = 'ROLE_CEO' %}
                                         {% endif %}

                                         <form action="{{ path('app_admin_set_role', {'id': user.id}) }}" method="POST" style="display: inline-block;">
                                             <input type="hidden" name="_token" value="{{ csrf_token('set_role_' ~ user.id) }}">
                                             <div class="select is-small">
                                                 <select name="role" onchange="this.form.submit()">
                                                     <option value="ROLE_RECRUIT" {{ current_role == 'ROLE_RECRUIT' ? 'selected' }}>Rekrut</option>
                                                     <option value="ROLE_MEMBER" {{ current_role == 'ROLE_MEMBER' ? 'selected' }}>Mitglied</option>
                                                     {% if is_user_ceo %}
                                                         <option value="ROLE_OFFICER" {{ current_role == 'ROLE_OFFICER' ? 'selected' }}>Officer</option>
                                                         <option value="ROLE_CEO" {{ current_role == 'ROLE_CEO' ? 'selected' }}>CEO</option>
                                                     {% endif %}
                                                 </select>
                                             </div>
                                         </form>
                                     {% endif %}
                                 </div>
                            {% endif %}
                        </td>
                    </tr>
                    
                    <!-- Live-Search No Results Row -->
                    <tr data-user-search-target="noResultsRow" style="display: none;">
                        <td colspan="3" class="has-text-centered py-5">
                            <span class="has-text-grey">Keine Benutzer mit diesem Namen gefunden.</span>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="has-text-centered py-5">
                            <span class="has-text-grey">Keine Benutzer gefunden.</span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
