{% extends 'base.html.twig' %}

{% block title %}Cron-Job-Verwaltung{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6">
    <!-- Headline -->
    <div class="level">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                ⏱️ Cron-Job-Verwaltung
            </h1>
        </div>
        <div class="level-right">
            <a href="{{ path('app_profile') }}" class="button is-dark">
                Zurück zum Profil
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notification is-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mt-4 mb-4">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Info Banner -->
    <div class="notification is-dark mb-5" style="border: 1px solid #333; background-color: rgba(255, 255, 255, 0.01);">
        💡 <strong>System-Konfiguration:</strong> Richte auf dem Server einen Cron-Job ein, der jede Minute das folgende Command triggert:
        <div class="box mt-2 mb-2 p-2 monospace-code has-text-primary" style="background-color: #111; font-family: monospace; border: 1px solid #222;">
            * * * * * cd /pfad/zur/anwendung && php bin/console app:cron:run &gt;/dev/null 2&gt;&amp;1
        </div>
        Der Server-Cron ruft das Command auf, und die Anwendung entscheidet anhand der unten definierten Zeitsteuerungen (Intervalle), welche Aufgaben gestartet werden.
    </div>

    <!-- Cron Jobs Table inside a Glassmorphism box -->
    <div class="box p-0 mt-5 overflow-x-auto" style="border: 1px solid #333;">
        <table class="table is-fullwidth is-striped mb-0" style="background: transparent;">
            <thead>
                <tr>
                    <th style="background: transparent; color: #888; border-bottom-color: #333;">Status</th>
                    <th style="background: transparent; color: #888; border-bottom-color: #333;">Name & Command</th>
                    <th style="background: transparent; color: #888; border-bottom-color: #333;">Intervall (Cron-Ausdruck)</th>
                    <th style="background: transparent; color: #888; border-bottom-color: #333;">Letzter Durchlauf</th>
                    <th style="background: transparent; color: #888; border-bottom-color: #333;">Nächster Durchlauf</th>
                    <th style="background: transparent; color: #888; border-bottom-color: #333;">Dauer</th>
                    <th style="background: transparent; color: #888; border-bottom-color: #333; text-align: right; padding-right: 20px;">Aktionen</th>
                </tr>
            </thead>
            <tbody>
                {% for job in cronJobs %}
                    <tr style="border-bottom: 1px solid #222;">
                        <!-- Status Badge -->
                        <td style="vertical-align: middle; border-bottom-color: #222;">
                            {% if not job.isActive %}
                                <span class="tag is-dark">Deaktiviert</span>
                            {% else %}
                                {% if job.lastStatus == 'success' %}
                                    <span class="tag is-success">Erfolgreich</span>
                                {% elseif job.lastStatus == 'error' %}
                                    <span class="tag is-danger">Fehlgeschlagen</span>
                                {% else %}
                                    <span class="tag is-info">Ausstehend</span>
                                {% endif %}
                            {% endif %}
                        </td>

                        <!-- Name & Command Key -->
                        <td style="vertical-align: middle; border-bottom-color: #222;">
                            <strong style="color: #fff;">{{ job.name }}</strong>
                            <p class="is-size-7 has-text-grey" style="font-family: monospace;">{{ job.command }}</p>
                        </td>

                        <!-- Cron Expression -->
                        <td style="vertical-align: middle; border-bottom-color: #222; font-family: monospace; font-weight: bold; color: var(--color-primary, #ffd700);">
                            {{ job.cronExpression }}
                        </td>

                        <!-- Last Run Time -->
                        <td style="vertical-align: middle; border-bottom-color: #222; color: #ccc;">
                            {% if job.lastRunAt is not null %}
                                {{ job.lastRunAt|date('d.m.Y H:i:s') }}
                            {% else %}
                                <span class="has-text-grey-light">nie</span>
                            {% endif %}
                        </td>

                        <!-- Next Run Time -->
                        <td style="vertical-align: middle; border-bottom-color: #222; color: #ccc;">
                            {% if job.isActive and job.nextRunAt is not null %}
                                {{ job.nextRunAt|date('d.m.Y H:i:s') }}
                            {% else %}
                                <span class="has-text-grey-light">-</span>
                            {% endif %}
                        </td>

                        <!-- Execution Duration -->
                        <td style="vertical-align: middle; border-bottom-color: #222; color: #aaa; font-family: monospace;">
                            {% if job.lastExecutionTime is not null %}
                                {{ job.lastExecutionTime|number_format(2, ',', '.') }} s
                            {% else %}
                                -
                            {% endif %}
                        </td>

                        <!-- Actions (Edit & Force Run) -->
                        <td style="vertical-align: middle; border-bottom-color: #222; text-align: right; padding-right: 20px;">
                            <div class="is-flex is-justify-content-flex-end" style="display: flex; gap: 8px; justify-content: flex-end; align-items: center; flex-wrap: wrap;">
                                <!-- Settings dropdown -->
                                <details style="background: rgba(0,0,0,0.2); border: 1px solid #444; border-radius: 4px; padding: 4px 8px; text-align: left;">
                                    <summary style="cursor: pointer; font-size: 0.75rem; color: #ccc; list-style: none;">⚙️ Bearbeiten</summary>
                                    <div class="mt-3" style="min-width: 250px;">
                                        <form action="{{ path('app_admin_cron_edit', { id: job.id }) }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cron_edit_' ~ job.id) }}">
                                            
                                            <div class="field mb-2" style="margin-bottom: 8px;">
                                                <label class="label is-small" style="color: #ccc; margin-bottom: 2px; font-size: 0.75rem; font-weight: 600;">Name</label>
                                                <input class="input is-small" type="text" name="name" value="{{ job.name }}" required style="background: #1a1a1a; color: #fff; border-color: #444; width: 100%; border-radius: 4px; padding: 5px;">
                                            </div>
                                            
                                            <div class="field mb-2" style="margin-bottom: 8px;">
                                                <label class="label is-small" style="color: #ccc; margin-bottom: 2px; font-size: 0.75rem; font-weight: 600;">Cron-Ausdruck (z.B. */10 * * * *)</label>
                                                <input class="input is-small" type="text" name="cronExpression" value="{{ job.cronExpression }}" required style="background: #1a1a1a; color: #fff; border-color: #444; width: 100%; border-radius: 4px; padding: 5px; font-family: monospace;">
                                            </div>
                                            
                                            <div class="field mb-3" style="margin-bottom: 12px; display: flex; align-items: center; gap: 5px;">
                                                <input type="checkbox" id="isActive_{{ job.id }}" name="isActive" value="1" {% if job.isActive %}checked{% endif %}>
                                                <label for="isActive_{{ job.id }}" style="color: #ccc; font-size: 0.85rem; cursor: pointer; user-select: none;">Aktiviert</label>
                                            </div>
                                            
                                            <button type="submit" class="button is-success is-small is-fullwidth" style="width: 100%;">Speichern</button>
                                        </form>
                                    </div>
                                </details>

                                <!-- Manual execute button -->
                                <form action="{{ path('app_admin_cron_run', { id: job.id }) }}" method="POST" style="margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cron_run_' ~ job.id) }}">
                                    <button type="submit" class="button is-primary is-small" style="height: 28px;">
                                        ⚡ Sofort ausführen
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    <!-- If there is an error in the last run, show details line -->
                    {% if job.isActive and job.lastStatus == 'error' and job.lastError is not empty %}
                        <tr style="background-color: rgba(241, 70, 104, 0.05);">
                            <td colspan="7" style="border-bottom-color: #333; padding: 10px 20px;">
                                <details style="border: 1px dashed rgba(241, 70, 104, 0.5); border-radius: 4px; padding: 8px; background: rgba(0,0,0,0.3);">
                                    <summary style="cursor: pointer; font-size: 0.8rem; color: #f14668; font-weight: bold; list-style: none; display: flex; align-items: center; gap: 5px;">
                                        <span>⚠️</span> Fehlermeldung anzeigen (Stack Trace)
                                    </summary>
                                    <pre class="mt-2 p-3 is-size-7" style="background-color: #111; color: #f14668; border-radius: 4px; border: 1px solid #222; overflow-x: auto; white-space: pre-wrap; font-family: monospace;">{{ job.lastError }}</pre>
                                </details>
                            </td>
                        </tr>
                    {% endif %}
                {% else %}
                    <tr>
                        <td colspan="7" class="has-text-centered p-5 has-text-grey">
                            Keine Cron-Jobs registriert. Führe den Cron-Runner auf der CLI einmal aus, um den Standard-Sync-Job automatisch zu registrieren.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
