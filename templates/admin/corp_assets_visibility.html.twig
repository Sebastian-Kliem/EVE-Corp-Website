{% extends 'base.html.twig' %}

{% block title %}Corp-Inventar Hangar-Sichtbarkeit{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6">
    <div class="level mb-4">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                Hangar-Sichtbarkeit
            </h1>
        </div>
    </div>

    <p class="subtitle is-6 has-text-grey mb-5">
        Lege fest, welche Hangars einer Station/Zitadelle für normale Mitglieder sichtbar sein sollen.
        Wenn neue Zitadellen oder Stationen hinzukommen, sind diese standardmäßig für andere unsichtbar, bis sie hier freigegeben werden.
    </p>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notification is-{{ label == 'error' ? 'danger' : 'success' }} mt-4 mb-4">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <form action="{{ path('app_admin_corp_assets_visibility') }}" method="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_corp_assets_visibility') }}">

        <div data-react-component="CorpAssetsVisibilityManager" data-react-props="{{ {
            locations: locations,
            flagsToMap: flagsToMap,
            defaultDivisions: defaultDivisions,
            corpDivisions: corpDivisions,
            initialVisibility: visibilityMap,
            allUsers: allUsers
        }|json_encode|e('html_attr') }}"></div>
    </form>
</div>
{% endblock %}
