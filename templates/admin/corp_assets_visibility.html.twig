{% extends 'base.html.twig' %}

{% block title %}Corp-Inventar Hangar-Sichtbarkeit{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6">
    <div class="level mb-4">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                ⚙️ Hangar-Sichtbarkeit
            </h1>
        </div>
        <div class="level-right">
            <a href="{{ path('app_admin_users') }}" class="button is-light">👤 Benutzerverwaltung</a>
            <a href="{{ path('app_admin_cron_index') }}" class="button is-light ml-2">⏱️ Cron-Jobs</a>
        </div>
    </div>

    <p class="subtitle is-6 has-text-grey mb-5">
        Lege fest, welche Hangars einer Station/Zitadelle für normale Mitglieder sichtbar sein sollen. 
        Wenn neue Zitadellen oder Stationen hinzukommen, sind diese standardmäßig für andere unsichtbar, bis sie hier freigegeben werden.
    </p>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notification is-{{ label == 'error' ? 'danger' : 'success' }} mt-4 mb-4">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <form action="{{ path('app_admin_corp_assets_visibility') }}" method="POST">
        <input type="hidden" name="_token" value="{{ csrf_token('admin_corp_assets_visibility') }}">

        {% for locId, loc in locations %}
            <div class="box mb-5">
                <h3 class="title is-5 mb-4 admin-visibility-header">
                    📍 {{ loc.name }} 
                    {% if loc.systemName %}
                        <span class="tag is-dark ml-2">{{ loc.systemName }}</span>
                    {% endif %}
                </h3>
                
                <div class="admin-visibility-list">
                    {% for flag, label in flagsToMap %}
                        {% set hangarName = defaultDivisions[label] ?? 'Hangar ' ~ label %}
                        {% set isChecked = visibilityMap[locId][flag] ?? false %}
                        <div class="field mb-3">
                            <div class="control">
                                <label class="checkbox has-text-grey-light admin-visibility-checkbox-label">
                                    <input type="checkbox" name="visibility[{{ locId }}][{{ flag }}]" value="1" {% if isChecked %}checked{% endif %} class="admin-visibility-checkbox">
                                    <span>{{ hangarName }}</span>
                                </label>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% else %}
            <div class="notification is-warning">
                Bisher wurden keine Corporation-Assets in der Datenbank gefunden. 
                Bitte stelle sicher, dass der Synchronisierungs-Cronjob gelaufen ist.
            </div>
        {% endfor %}

        {% if locations is not empty %}
            <div class="field mt-5">
                <div class="control">
                    <button type="submit" class="button is-primary is-fullwidth">
                        💾 Sichtbarkeits-Freigaben speichern
                    </button>
                </div>
            </div>
        {% endif %}
    </form>
</div>
{% endblock %}
