{% extends 'base.html.twig' %}

{% block title %}Cron-Job-Verwaltung{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6">
    <!-- Headline -->
    <div class="level">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                ⏱️ Cron-Job-Verwaltung & Logs
            </h1>
        </div>
        <div class="level-right">
            <a href="{{ path('app_profile') }}" class="button is-dark">
                Zurück zum Profil
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notification is-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mt-4 mb-4">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Info Banner -->
    <div class="notification is-dark mb-5 cron-info-banner" style="background: rgba(0, 0, 0, 0.2); border: 1px solid var(--theme-card-border); border-radius: 8px;">
        💡 <strong>System-Konfiguration:</strong> Richte auf dem Server einen Cron-Job ein, der alle 5 Minuten das folgende Command triggert:
        <div class="box mt-2 mb-2 p-2 monospace-code has-text-primary cron-code-box" style="background: #000; border: 1px solid #222; font-family: monospace;">
            */5 * * * * cd {{ app.request.server.get('DOCUMENT_ROOT')|default('/var/www/html')|replace({'/public': ''}) }} && php bin/console app:cron:run &gt;/dev/null 2&gt;&amp;1
        </div>
        Der Scheduler läuft nun vollautomatisch im Hintergrund und arbeitet alle aktiven Aufgaben nacheinander (sequentiell) ab. Durch die integrierte Cache-Optimierung werden Daten nur dann tatsächlich von EVE Online geladen, wenn sie nicht mehr im ESI-Cache liegen, was Systemressourcen und API-Limit schont.
    </div>

    <!-- Actions & Terminal -->
    <div class="box mb-5" style="background: rgba(0, 0, 0, 0.15); border: 1px solid var(--theme-card-border); border-radius: 8px;">
        <div class="level mb-4">
            <div class="level-left">
                <div>
                    <h3 class="title is-5 mb-1" style="color: #fff; display: flex; align-items: center; gap: 8px;">
                        <span>📄</span> Ausführungsprotokoll (cron.log)
                    </h3>
                    <p class="is-size-7 has-text-grey">Zeigt die letzten 150 Einträge der Hintergrund-Synchronisierung</p>
                </div>
            </div>
            <div class="level-right">
                <form action="{{ path('app_admin_cron_run_all') }}" method="POST" style="display: inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('cron_run_all') }}">
                    <button type="submit" class="button is-primary" style="font-weight: bold;">
                        🔄 Synchronisierung jetzt manuell starten
                    </button>
                </form>
            </div>
        </div>

        <div style="background: #070708; border: 1px solid var(--theme-card-border); border-radius: 6px; box-shadow: inset 0 2px 10px rgba(0,0,0,0.8); padding: 15px;">
            <div style="overflow-y: auto; max-height: 600px; background: transparent;">
                <pre style="background: transparent; color: #abb2bf; font-family: 'Courier New', Courier, monospace; font-size: 0.85rem; border: none; padding: 0; white-space: pre-wrap; word-wrap: break-word; line-height: 1.4;">{{ logContent|raw }}</pre>
            </div>
        </div>
    </div>
</div>
{% endblock %}
