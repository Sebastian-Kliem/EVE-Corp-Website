{% extends 'base.html.twig' %}

{% block title %}Cron-Job-Verwaltung{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6">
    <!-- Headline -->
    <div class="level">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                ⏱️ Cron-Job-Verwaltung
            </h1>
        </div>
        <div class="level-right">
            <a href="{{ path('app_profile') }}" class="button">
                Zurück zum Profil
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notification is-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mt-4 mb-4">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Info Banner -->
    <div class="notification cron-info-banner mb-5">
        💡 <strong>System-Konfiguration:</strong> Richte auf dem Server einen Cron-Job ein, der alle 5 Minuten das folgende Command triggert:
        <div class="box mt-2 mb-2 p-3 cron-code-box monospace-code has-text-primary">
            */5 * * * * cd {{ app.request.server.get('DOCUMENT_ROOT')|default('/var/www/html')|replace({'/public': ''}) }} && php bin/console app:cron:run &gt;/dev/null 2&gt;&amp;1
        </div>
        Der Scheduler läuft vollautomatisch im Hintergrund. Daten werden durch die integrierte Cache-Optimierung nur dann von EVE Online geladen, wenn sie nicht mehr im ESI-Cache liegen.
    </div>

    <!-- Cron Jobs Table -->
    <div class="box mb-5">
        <div class="level mb-4">
            <div class="level-left">
                <div>
                    <h3 class="title is-5 mb-1">
                        📋 Registrierte Hintergrund-Jobs
                    </h3>
                    <p class="is-size-7 has-text-grey-light">Übersicht aller automatischen Synchronisations-Aufgaben</p>
                </div>
            </div>
            <div class="level-right">
                <form action="{{ path('app_admin_cron_run_all') }}" method="POST" class="cron-action-form">
                    <input type="hidden" name="_token" value="{{ csrf_token('cron_run_all') }}">
                    <button type="submit" class="button is-primary">
                        🔄 Alle fälligen Jobs synchronisieren
                    </button>
                </form>
            </div>
        </div>

        <div class="cron-table-container">
            <table class="table is-striped">
                <thead>
                    <tr>
                        <th>Job-Name / Command</th>
                        <th>Intervall</th>
                        <th>Status</th>
                        <th>Letzter Lauf</th>
                        <th>Nächster Lauf</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for job in cronJobs %}
                        <tr>
                            <td>
                                <strong>{{ job.name }}</strong>
                                <br>
                                <small class="has-text-grey-light">{{ job.command }}</small>
                            </td>
                            <td>
                                <span class="tag monospace-code">{{ job.cronExpression }}</span>
                            </td>
                            <td>
                                <span class="cron-status-badge {{ job.isActive ? 'cron-status-active' : 'cron-status-inactive' }}">
                                    {{ job.isActive ? 'Aktiv' : 'Inaktiv' }}
                                </span>
                                <br>
                                {% if job.lastStatus == 'success' %}
                                    <span class="tag is-success mt-1">Erfolgreich</span>
                                {% elseif job.lastStatus == 'error' %}
                                    <span class="tag is-danger mt-1">Fehlgeschlagen</span>
                                {% else %}
                                    <span class="tag is-info mt-1">Ausstehend</span>
                                {% endif %}
                            </td>
                            <td class="is-size-7">
                                {% if job.lastRunAt %}
                                    {{ job.lastRunAt|date('d.m.Y H:i:s') }}
                                    {% if job.lastExecutionTime %}
                                        <br>
                                        <span class="has-text-grey-light">Dauer: {{ job.lastExecutionTime|number_format(2) }}s</span>
                                    {% endif %}
                                {% else %}
                                    <span class="has-text-grey-light">Nie</span>
                                {% endif %}
                            </td>
                            <td class="is-size-7">
                                {% if job.nextRunAt %}
                                    {{ job.nextRunAt|date('d.m.Y H:i:s') }}
                                {% else %}
                                    <span class="has-text-grey-light">-</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="buttons">
                                    <form action="{{ path('app_admin_cron_toggle', {id: job.id}) }}" method="POST" class="cron-action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cron_toggle_' ~ job.id) }}">
                                        <button type="submit" class="button is-small">
                                            {{ job.isActive ? 'Deaktivieren' : 'Aktivieren' }}
                                        </button>
                                    </form>
                                    <form action="{{ path('app_admin_cron_run_single', {id: job.id}) }}" method="POST" class="cron-action-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cron_run_' ~ job.id) }}">
                                        <button type="submit" class="button is-small is-primary">
                                            Ausführen
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% if job.lastStatus == 'error' and job.lastError %}
                            <tr>
                                <td colspan="6" class="p-0">
                                    <details class="mb-3 ml-2 mr-2">
                                        <summary class="is-size-7 has-text-danger p-2" style="cursor: pointer; font-weight: bold;">
                                            ❌ Fehlermeldung anzeigen
                                        </summary>
                                        <div class="cron-error-details">
                                            {{ job.lastError }}
                                        </div>
                                    </details>
                                </td>
                            </tr>
                        {% endif %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="has-text-centered has-text-grey-light">
                                Keine registrierten Cron-Jobs gefunden.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Logs Section -->
    <div class="box cron-log-section">
        <div class="level mb-4">
            <div class="level-left">
                <div>
                    <h3 class="title is-5 mb-1">
                        📄 Letzte Log-Aktivitäten
                    </h3>
                    <p class="is-size-7 has-text-grey-light">Speicherschonende Live-Vorschau der letzten Protokolleinträge</p>
                </div>
            </div>
            <div class="level-right">
                {% if logFileExists %}
                    <a href="{{ path('app_admin_cron_download_log') }}" class="button is-small">
                        📥 Gesamtes Log herunterladen
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="cron-terminal-box">
            <div class="cron-terminal-container">
                <div class="cron-terminal-text">{{ logContent|raw }}</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

