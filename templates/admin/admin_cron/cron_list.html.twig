{% extends 'base.html.twig' %}

{% block title %}Cron-Job-Verwaltung{% endblock %}

{% block body %}
<div class="container container-wide mt-5 mb-6">
    <!-- Headline -->
    <div class="level">
        <div class="level-left">
            <h1 class="title is-2 text-gradient">
                ⏱️ Cron-Job-Verwaltung
            </h1>
        </div>
        <div class="level-right">
            <a href="{{ path('app_profile') }}" class="button is-dark">
                Zurück zum Profil
            </a>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="notification is-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} mt-4 mb-4">
                {{ message|raw }}
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Info Banner -->
    <div class="notification is-dark mb-5 cron-info-banner">
        💡 <strong>System-Konfiguration:</strong> Richte auf dem Server einen Cron-Job ein, der jede Minute das folgende Command triggert:
        <div class="box mt-2 mb-2 p-2 monospace-code has-text-primary cron-code-box">
            * * * * * cd /pfad/zur/anwendung && php bin/console app:cron:run &gt;/dev/null 2&gt;&amp;1
        </div>
        Der Server-Cron ruft das Command auf, und die Anwendung entscheidet anhand der unten definierten Zeitsteuerungen (Intervalle), welche Aufgaben gestartet werden.
    </div>

    <!-- Cron Jobs Table inside a Glassmorphism box -->
    <div class="box p-0 mt-5 overflow-x-auto cron-table-box">
        <table class="table is-fullwidth is-striped mb-0 cron-table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Name & Command</th>
                    <th>Intervall (Cron-Ausdruck)</th>
                    <th>Letzter Durchlauf</th>
                    <th>Nächster Durchlauf</th>
                    <th>Dauer</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                {% for job in cronJobs %}
                    <tr>
                        <!-- Status Badge -->
                        <td>
                            {% if not job.isActive %}
                                <span class="tag is-dark">Deaktiviert</span>
                            {% else %}
                                {% if job.lastStatus == 'success' %}
                                    <span class="tag is-success">Erfolgreich</span>
                                {% elseif job.lastStatus == 'error' %}
                                    <span class="tag is-danger">Fehlgeschlagen</span>
                                {% else %}
                                    <span class="tag is-info">Ausstehend</span>
                                {% endif %}
                            {% endif %}
                        </td>

                        <!-- Name & Command Key -->
                        <td>
                            <strong class="has-text-white">{{ job.name }}</strong>
                            <p class="is-size-7 has-text-grey font-family-monospace">{{ job.command }}</p>
                        </td>

                        <!-- Cron Expression -->
                        <td class="font-family-monospace has-text-weight-bold has-text-primary">
                            {{ job.cronExpression }}
                        </td>

                        <!-- Last Run Time -->
                        <td class="has-text-grey-light">
                            {% if job.lastRunAt is not null %}
                                {{ job.lastRunAt|date('d.m.Y H:i:s') }}
                            {% else %}
                                <span class="has-text-grey-light">nie</span>
                            {% endif %}
                        </td>

                        <!-- Next Run Time -->
                        <td class="has-text-grey-light">
                            {% if job.isActive and job.nextRunAt is not null %}
                                {{ job.nextRunAt|date('d.m.Y H:i:s') }}
                            {% else %}
                                <span class="has-text-grey-light">-</span>
                            {% endif %}
                        </td>

                        <!-- Execution Duration -->
                        <td class="has-text-grey font-family-monospace">
                            {% if job.lastExecutionTime is not null %}
                                {{ job.lastExecutionTime|number_format(2, ',', '.') }} s
                            {% else %}
                                -
                            {% endif %}
                        </td>

                        <!-- Actions (Edit & Force Run) -->
                        <td>
                            <div class="cron-table-actions-container">
                                <!-- Settings dropdown -->
                                <details class="cron-details-edit">
                                    <summary class="cron-details-summary-btn">⚙️ Bearbeiten</summary>
                                    <div class="mt-3 cron-edit-form-container">
                                        <form action="{{ path('app_admin_cron_edit', { id: job.id }) }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('cron_edit_' ~ job.id) }}">

                                            <div class="field mb-2 cron-edit-field-group">
                                                <label class="label is-small cron-edit-label">Name</label>
                                                <input class="input is-small cron-edit-input" type="text" name="name" value="{{ job.name }}" required>
                                            </div>

                                            <div class="field mb-2 cron-edit-field-group">
                                                <label class="label is-small cron-edit-label">Cron-Ausdruck (z.B. */10 * * * *)</label>
                                                <input class="input is-small cron-edit-input font-family-monospace" type="text" name="cronExpression" value="{{ job.cronExpression }}" required>
                                            </div>

                                            <div class="field mb-3 cron-checkbox-field">
                                                <input type="checkbox" id="isActive_{{ job.id }}" name="isActive" value="1" {% if job.isActive %}checked{% endif %}>
                                                <label for="isActive_{{ job.id }}" class="cron-checkbox-label">Aktiviert</label>
                                            </div>

                                            <button type="submit" class="button is-success is-small is-fullwidth cron-edit-button">Speichern</button>
                                        </form>
                                    </div>
                                </details>

                                <!-- Manual execute button -->
                                <form action="{{ path('app_admin_cron_run', { id: job.id }) }}" method="POST" class="cron-inline-form">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cron_run_' ~ job.id) }}">
                                    <button type="submit" class="button is-primary is-small cron-run-button">
                                        Ausführen
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    <!-- If there is an error in the last run, show details line -->
                    {% if job.isActive and job.lastStatus == 'error' and job.lastError is not empty %}
                        <tr class="cron-error-row">
                            <td colspan="7">
                                <details class="cron-error-details">
                                    <summary class="cron-error-summary">
                                        <span>⚠️</span> Fehlermeldung anzeigen (Stack Trace)
                                    </summary>
                                    <pre class="mt-2 p-3 is-size-7 cron-error-pre">{{ job.lastError }}</pre>
                                </details>
                            </td>
                        </tr>
                    {% endif %}
                {% else %}
                    <tr>
                        <td colspan="7" class="has-text-centered p-5 has-text-grey">
                            Keine Cron-Jobs registriert. Führe den Cron-Runner auf der CLI einmal aus, um den Standard-Sync-Job automatisch zu registrieren.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
