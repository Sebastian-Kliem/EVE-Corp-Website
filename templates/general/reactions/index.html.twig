{% extends 'base.html.twig' %}

{% block title %}Wurmloch-Reaktionen Kalkulator{% endblock %}

{% block body %}
<div class="w-full max-w-[1200px] mx-auto px-6 mt-8">
    <details class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-0 overflow-hidden group" open>
        <summary class="p-5 font-semibold cursor-pointer list-none flex justify-between items-center select-none transition-colors duration-200 text-xl text-white">
            <span>🧪 Wurmloch-Reaktionen (Kalkulator)</span>
            <span class="text-xs text-eve-primary transition-transform duration-200 group-open:rotate-180">▼</span>
        </summary>
        <div class="p-6 border-t border-eve-border">
            {% set reactProps = {
                apiDataUrl: path('app_general_reactions_data'),
                imagePaths: {
                    types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' })
                },
                structuresList: structuresList
            } %}
            <div data-react-component="ReactionDashboard" data-react-props="{{ reactProps|json_encode|e('html_attr') }}"></div>
        </div>
    </details>
</div>
{% endblock %}
