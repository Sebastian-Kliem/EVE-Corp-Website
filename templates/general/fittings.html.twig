{% extends 'base.html.twig' %}

{% block title %}Fittings{% endblock %}

{% block body %}
<div class="w-full px-6 mt-10 mb-12">
    <div class="mb-8">
        <h1 class="text-3xl font-semibold mb-2 text-white text-gradient">Fittings</h1>
        <p class="text-sm text-eve-muted">
            Gemeinsame Fit-Bibliothek der Corp: Ingame-Fits aller Charaktere, eigene Fits per EFT, Tags und wer das Fit fliegen kann.
        </p>
    </div>

    {% set fittingProps = {
        initialLibrary: library,
        canManageCorpFlag: canManageCorpFlag,
        initialFittingId: app.request.query.getInt('fit') ?: null,
        imagePaths: {
            types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' }),
            characters: path('app_eve_image_proxy', { category: 'characters', id: 12345, action: 'portrait' })
        },
        apiEndpoints: {
            create: path('app_general_fittings_create'),
            preview: path('app_general_fittings_preview'),
            detail: path('app_general_fittings_detail', { id: 123456789 }),
            update: path('app_general_fittings_update', { id: 123456789 }),
            tags: path('app_general_fittings_tags', { id: 123456789 }),
            corpFlag: path('app_general_fittings_corp_flag', { id: 123456789 }),
            delete: path('app_general_fittings_delete', { id: 123456789 }),
            importOwn: path('app_general_fittings_import'),
            saveIngame: path('app_general_fittings_save_ingame', { id: 123456789 }),
            refreshCopy: path('app_general_fittings_refresh_copy', { copyId: 123456789 }),
            deleteCopy: path('app_general_fittings_delete_copy', { copyId: 123456789 })
        }
    } %}

    <div data-react-component="FittingLibrary" data-react-props="{{ fittingProps|json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
