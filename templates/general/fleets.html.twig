{% extends 'base.html.twig' %}

{% block title %}Flotten{% endblock %}

{% block body %}
<div class="w-full px-6 mt-10 mb-12">
    <div class="mb-8">
        <h1 class="text-3xl font-semibold mb-2 text-white text-gradient">Flotten</h1>
        <p class="text-sm text-eve-muted">
            Flotten-Sets aus mehreren Fits mit Rolle und Anzahl. Pro Fit siehst du, welche Piloten es fliegen können.
        </p>
    </div>

    {% set fleetProps = {
        initialFleets: fleets,
        library: library,
        fittingsUrl: path('app_general_fittings'),
        imagePaths: {
            types: path('app_eve_image_proxy', { category: 'types', id: 12345, action: 'icon' })
        },
        apiEndpoints: {
            create: path('app_general_fleets_create'),
            update: path('app_general_fleets_update', { id: 123456789 }),
            delete: path('app_general_fleets_delete', { id: 123456789 })
        }
    } %}

    <div data-react-component="FleetCompositions" data-react-props="{{ fleetProps|json_encode|e('html_attr') }}"></div>
</div>
{% endblock %}
