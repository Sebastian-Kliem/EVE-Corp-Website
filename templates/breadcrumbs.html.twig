{# templates/breadcrumbs.html.twig #}
{# Trail is derived from App\Service\Navigation\NavigationMenu #}
{% set breadcrumbs = app.user ? get_breadcrumbs() : [] %}

{% if breadcrumbs is not empty %}
    <nav class="py-3 mb-6 text-sm" aria-label="breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 list-none p-0 m-0">
            <li class="flex items-center">
                <a href="{{ path('home') }}" class="text-eve-muted hover:text-eve-primary no-underline transition-colors duration-200">Home</a>
            </li>
            {% for crumb in breadcrumbs %}
                <li class="text-white/20 select-none text-xs" aria-hidden="true">&gt;</li>
                <li class="flex items-center">
                    {% if crumb.route is not null and not loop.last %}
                        <a href="{{ path(crumb.route) }}" class="text-eve-muted hover:text-eve-primary no-underline transition-colors duration-200">{{ crumb.label }}</a>
                    {% elseif not loop.last %}
                        <span class="text-eve-muted font-medium">{{ crumb.label }}</span>
                    {% else %}
                        <span class="text-eve-primary font-medium [text-shadow:0_0_8px_rgba(0,240,255,0.3)]">{{ crumb.label }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
