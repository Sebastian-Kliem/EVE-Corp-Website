<!DOCTYPE html>
<html data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        <link rel="shortcut icon" href="/favicon.ico">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}


    </head>
    <body>
        <header>
            {# Hier wird das Partial-Template der Navigation eingebunden #}
            {% include 'navigation.html.twig' %}
        </header>

        {% if app.user %}
            {% set invalid_chars = get_sso_warnings() %}
            {% if invalid_chars is not empty %}
                <div class="w-full max-w-[1200px] mx-auto px-6 mt-6">
                    <div class="border border-red-500/30 bg-red-500/10 text-red-400 rounded-lg p-5 relative">
                        <button class="absolute top-4 right-4 text-red-400 hover:text-white cursor-pointer text-xl leading-none" onclick="this.parentElement.style.display='none'">&times;</button>
                        <div class="flex items-start gap-3">
                            <span class="text-xl">⚠️</span>
                            <span>
                                <strong class="font-bold text-white">SSO-Authentifizierung erforderlich:</strong> Die folgenden Charaktere haben keinen gültigen Zugriff mehr (z. B. durch Passwortänderung). Bitte führe ein Re-Auth im Profil durch:
                                <ul class="list-disc list-inside mt-2 space-y-1">
                                    {% for char in invalid_chars %}
                                        <li>
                                            <strong class="font-bold text-white">{{ char.name }}</strong> 
                                            (<a href="{{ path('app_profile') }}" class="font-bold text-eve-primary hover:text-eve-primary-hover underline">Zum Profil</a> / 
                                            <a href="{{ path('app_eve_sso_login') }}" class="font-bold text-eve-primary hover:text-eve-primary-hover underline">Direkt Re-Auth</a>)
                                        </li>
                                    {% endfor %}
                                </ul>
                            </span>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}

        {% set flash_classes = {
            'error': 'bg-red-500/10 border-red-500/30 text-red-400',
            'danger': 'bg-red-500/10 border-red-500/30 text-red-400',
            'warning': 'bg-amber-500/10 border-amber-500/30 text-amber-400',
            'success': 'bg-green-500/10 border-green-500/30 text-green-400',
            'info': 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400'
        } %}

        <div class="w-full max-w-[1200px] mx-auto px-6 mt-6">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="border border-eve-border bg-eve-card rounded-lg p-5 mb-6 relative {{ flash_classes[label] ?? 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400' }}">
                        <button class="absolute top-4 right-4 text-eve-muted hover:text-white cursor-pointer text-xl leading-none" onclick="this.parentElement.style.display='none'">&times;</button>
                        {{ message|raw }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
    </body>
</html>
