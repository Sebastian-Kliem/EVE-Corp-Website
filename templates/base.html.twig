<!DOCTYPE html>
<html data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        <link rel="shortcut icon" href="/favicon.ico">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}


    </head>
    <body>
        <header>
            {# Hier wird das Partial-Template der Navigation eingebunden #}
            {% include 'navigation.html.twig' %}
        </header>

        {% if app.user %}
            {% set invalid_chars = get_sso_warnings() %}
            {% if invalid_chars is not empty %}
                <div class="container mt-4">
                    <div class="notification is-danger">
                        <button class="delete" onclick="this.parentElement.style.display='none'"></button>
                        <span class="icon-text">
                            <span class="icon">⚠️</span>
                            <span>
                                <strong>SSO-Authentifizierung erforderlich:</strong> Die folgenden Charaktere haben keinen gültigen Zugriff mehr (z. B. durch Passwortänderung). Bitte führe ein Re-Auth im Profil durch:
                                <ul>
                                    {% for char in invalid_chars %}
                                        <li>
                                            <strong>{{ char.name }}</strong> 
                                            (<a href="{{ path('app_profile') }}" class="has-text-weight-bold" style="text-decoration: underline;">Zum Profil</a> / 
                                            <a href="{{ path('app_eve_sso_login') }}" class="has-text-weight-bold" style="text-decoration: underline;">Direkt Re-Auth</a>)
                                        </li>
                                    {% endfor %}
                                </ul>
                            </span>
                        </span>
                    </div>
                </div>
            {% endif %}
        {% endif %}

        {% set flash_classes = {
            'error': 'is-danger',
            'danger': 'is-danger',
            'warning': 'is-warning',
            'success': 'is-success',
            'info': 'is-info'
        } %}

        <div class="container mt-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="notification {{ flash_classes[label] ?? 'is-info' }}">
                        {{ message|raw }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
    </body>
</html>
