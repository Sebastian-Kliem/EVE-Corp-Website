<!DOCTYPE html>
<html data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">
        <link rel="shortcut icon" href="/favicon.ico">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}


    </head>
    <body>
        {% if app.user %}
            {% set invalid_chars = get_sso_warnings() %}
            {% if invalid_chars is not empty %}
                <a href="{{ path('app_profile') }}" class="group block w-full bg-red-950/50 hover:bg-red-900/60 border-b border-red-500/40 text-red-200 transition-colors py-2 px-4 no-underline relative z-50">
                    <div class="w-full max-w-[1200px] mx-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs sm:text-sm">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0">
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-500/25 text-red-300 border border-red-500/40 shrink-0">
                                SSO-Warnung
                            </span>
                            <span class="text-eve-muted font-normal">Re-Auth erforderlich für:</span>
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                {% for char in invalid_chars %}
                                    <span class="inline-flex items-center gap-1.5">
                                        <strong class="font-semibold text-white group-hover:text-red-200 transition-colors">{{ char.name }}</strong>
                                        <span class="text-xs text-red-400 font-medium">(Zugriff abgelaufen)</span>
                                        {% if not loop.last %}<span class="text-white/20">•</span>{% endif %}
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                        <span class="text-xs text-red-400/80 group-hover:text-white font-medium inline-flex items-center gap-1 transition-colors shrink-0 ml-auto sm:ml-0">
                            Zum Profil (Re-Auth) →
                        </span>
                    </div>
                </a>
            {% endif %}

            {% set fuel_warnings = get_fuel_warnings() %}
            {% if fuel_warnings is not empty %}
                <a href="{{ path('app_corp_structures') }}" class="group block w-full bg-red-950/40 hover:bg-red-900/50 border-b border-red-500/30 text-red-200 transition-colors py-2 px-4 no-underline relative z-50">
                    <div class="w-full max-w-[1200px] mx-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-xs sm:text-sm">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 min-w-0">
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30 shrink-0">
                                Treibstoff-Warnung
                            </span>
                            <span class="text-eve-muted font-normal">Stationen &lt; 30 Tage:</span>
                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                                {% for warning in fuel_warnings %}
                                    <span class="inline-flex items-center gap-1.5">
                                        <strong class="font-semibold text-white group-hover:text-red-200 transition-colors">{{ warning.name }}</strong>
                                        <span class="text-eve-muted text-xs">({{ warning.solarSystemName }})</span>
                                        <span class="font-medium {{ warning.isExpired or warning.daysRemaining < 7 ? 'text-red-400' : 'text-amber-300' }}">
                                            {{ warning.isExpired ? 'Treibstoff abgelaufen' : warning.formattedTime }}
                                        </span>
                                        {% if not loop.last %}<span class="text-white/20">•</span>{% endif %}
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                        <span class="text-xs text-red-400/80 group-hover:text-white font-medium inline-flex items-center gap-1 transition-colors shrink-0 ml-auto sm:ml-0">
                            Zur Stationsübersicht →
                        </span>
                    </div>
                </a>
            {% endif %}
        {% endif %}

        <header>
            {# Hier wird das Partial-Template der Navigation eingebunden #}
            {% include 'navigation.html.twig' %}
        </header>

        {% if app.user %}
            <div class="w-full max-w-[1200px] mx-auto px-6 mt-4">
                {% include 'breadcrumbs.html.twig' %}
            </div>
        {% endif %}

        {% set flash_classes = {
            'error': 'bg-red-500/10 border-red-500/30 text-red-400',
            'danger': 'bg-red-500/10 border-red-500/30 text-red-400',
            'warning': 'bg-amber-500/10 border-amber-500/30 text-amber-400',
            'success': 'bg-green-500/10 border-green-500/30 text-green-400',
            'info': 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400'
        } %}

        <div class="w-full max-w-[1200px] mx-auto px-6 mt-6">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="border border-eve-border bg-eve-card rounded-lg p-5 mb-6 relative {{ flash_classes[label] ?? 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400' }}">
                        <button class="absolute top-4 right-4 text-eve-muted hover:text-white cursor-pointer text-xl leading-none" onclick="this.parentElement.style.display='none'">&times;</button>
                        {{ message|raw }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
    </body>
</html>
