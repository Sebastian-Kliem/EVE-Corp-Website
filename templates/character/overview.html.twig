{% extends 'base.html.twig' %}

{% block title %}Charakterübersicht{% endblock %}

{% macro character_card(char, missingScopesByCharacter) %}
    <div class="flex-1 min-w-[260px] max-w-[calc(33.333%-11px)]">
        <div class="p-3 bg-black/20 rounded-md border border-white/10 h-full">
            {% include 'character/_character_card_header.html.twig' with { char: char } only %}

            <div class="flex gap-2">
                <a href="{{ path('app_dashboard_eve_character_details', { id: char.id }) }}" class="flex-1 h-[26px] inline-flex items-center justify-center gap-1 px-2 py-1 text-xs rounded border border-sky-500/30 bg-sky-500/10 text-sky-400 hover:bg-sky-500/20 transition-all cursor-pointer">
                    Details
                </a>
                <a href="{{ path('app_dashboard_eve_character_assets', { id: char.id }) }}" class="flex-1 h-[26px] inline-flex items-center justify-center gap-1 px-2 py-1 text-xs rounded border border-white/10 bg-white/5 text-white hover:bg-white/10 transition-all cursor-pointer">
                    Inventar
                </a>
            </div>

            {# Problems are only pointed out here; fixing them happens on the management page #}
            {% if not char.tokenValid %}
                <a href="{{ path('app_profile_character_management') }}" class="block bg-rose-500/10 border border-rose-500/30 text-rose-400 hover:bg-rose-500/20 p-2 mt-3 text-xs rounded no-underline">
                    <strong>SSO ungültig.</strong> Re-Auth unter Charaktere verwalten.
                </a>
            {% elseif missingScopesByCharacter[char.id] is defined %}
                <a href="{{ path('app_profile_character_management') }}" class="block bg-amber-500/10 border border-amber-500/30 text-amber-400 hover:bg-amber-500/20 p-2 mt-3 text-xs rounded no-underline">
                    <strong>Berechtigungen fehlen:</strong> {{ missingScopesByCharacter[char.id]|length }} ESI-Scopes. Re-Auth unter Charaktere verwalten.
                </a>
            {% endif %}
        </div>
    </div>
{% endmacro %}

{% block body %}
<div class="w-full max-w-[900px] mx-auto px-6 mt-10 mb-12">
    <div class="flex flex-wrap justify-between items-center gap-4 mb-4">
        <h1 class="text-3xl font-semibold mb-0 text-white text-gradient">
            Charakterübersicht
        </h1>
        <a href="{{ path('app_profile_character_management') }}" class="inline-flex items-center justify-center border border-sky-500/30 hover:border-sky-500 bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 rounded px-3 py-1.5 text-xs font-semibold transition-all duration-300 no-underline">
            Charaktere verwalten
        </a>
    </div>

    {% if accounts is empty and unassignedCharacters is empty %}
        <div class="py-5 px-6 rounded-lg mb-6 bg-sky-500/10 border border-sky-500/30 text-sky-400 mt-3">
            Bisher sind keine EVE Online Charaktere verknüpft. Unter
            <a href="{{ path('app_profile_character_management') }}" class="text-eve-primary hover:underline">Charaktere verwalten</a>
            kannst du einen Charakter über EVE SSO hinzufügen.
        </div>
    {% endif %}

    {% for account in accounts %}
        <div class="bg-eve-card border border-eve-border backdrop-blur-md shadow-eve rounded-lg p-4 mb-4">
            <div class="border-b border-white/10 pb-2.5 mb-4">
                <span class="font-bold text-lg text-white flex items-center gap-2">
                    {{ account.name }}
                    {% if account.isOmega %}
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded bg-amber-500/15 text-amber-400 border border-amber-500/30 ml-2">Omega</span>
                    {% else %}
                        <span class="px-2 py-0.5 text-[10px] font-semibold rounded bg-white/10 text-white border border-white/10 ml-2">Alpha</span>
                    {% endif %}
                </span>
            </div>

            <div class="flex flex-wrap gap-4">
                {% for char in account.characters %}
                    {{ _self.character_card(char, missingScopesByCharacter) }}
                {% else %}
                    <p class="w-full text-xs text-eve-muted text-center py-4">Keine Charaktere in diesem Account.</p>
                {% endfor %}
            </div>
        </div>
    {% endfor %}

    {% if unassignedCharacters is not empty %}
        <div class="bg-eve-card border border-dashed border-eve-border backdrop-blur-md shadow-eve rounded-lg p-4 mb-4">
            <div class="border-b border-white/10 pb-2.5 mb-4">
                <span class="font-bold text-lg text-white">Ohne Account-Ordner</span>
            </div>
            <div class="flex flex-wrap gap-4">
                {% for char in unassignedCharacters %}
                    {{ _self.character_card(char, missingScopesByCharacter) }}
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
