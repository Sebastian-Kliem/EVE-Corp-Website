{
  "name": "wh-toolbox-react-islands",
  "private": true,
  "version": "1.0.0",
  "description": "React + TypeScript Islands isolated in project root",
  "scripts": {
    "build:js": "esbuild src/index.tsx --bundle --minify --format=esm --sourcemap --outfile=../assets/react.js --tsconfig=tsconfig.json",
    "build:css": "npx @tailwindcss/cli -i src/input.css -o ../assets/styles/app.css --minify",
    "build": "npm run build:css && npm run build:js",
    "watch:js": "esbuild src/index.tsx --bundle --format=esm --sourcemap --outfile=../assets/react.js --tsconfig=tsconfig.json --watch",
    "watch:css": "npx @tailwindcss/cli -i src/input.css -o ../assets/styles/app.css --watch",
    "watch": "concurrently \"npm run watch:css\" \"npm run watch:js\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.21.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.4.5"
  }
}
